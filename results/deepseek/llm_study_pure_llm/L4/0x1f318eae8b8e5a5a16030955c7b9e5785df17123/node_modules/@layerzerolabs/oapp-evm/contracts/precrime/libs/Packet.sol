pragma solidity ^0.8.20;

// Solang on Solana does not support external imports from node_modules in the same way.
// We need to inline the required types and library functions.
// The following definitions are adapted for Solana compatibility.

// Origin struct from ILayerZeroEndpointV2
struct Origin {
    uint32 srcEid;
    bytes32 sender;
    uint64 nonce;
}

// InboundPacket struct
struct InboundPacket {
    Origin origin;
    uint32 dstEid;
    address receiver;
    bytes32 guid;
    uint256 value;
    address executor;
    bytes message;
    bytes extraData;
}

// PacketV1Codec library adapted for Solana/Solang
library PacketV1Codec {
    // Constants for offsets in the packet bytes
    uint256 constant SRC_EID_OFFSET = 0;
    uint256 constant SENDER_OFFSET = 4;
    uint256 constant DST_EID_OFFSET = 36;
    uint256 constant RECEIVER_OFFSET = 40;
    uint256 constant GUID_OFFSET = 60;
    uint256 constant MESSAGE_OFFSET = 92;

    function srcEid(bytes calldata _packet) internal pure returns (uint32) {
        require(_packet.length >= SRC_EID_OFFSET + 4, "PacketV1Codec: invalid packet length");
        uint32 eid;
        assembly {
            eid := calldataload(add(_packet.offset, SRC_EID_OFFSET))
        }
        return eid;
    }

    function sender(bytes calldata _packet) internal pure returns (bytes32) {
        require(_packet.length >= SENDER_OFFSET + 32, "PacketV1Codec: invalid packet length");
        bytes32 senderBytes;
        assembly {
            senderBytes := calldataload(add(_packet.offset, SENDER_OFFSET))
        }
        return senderBytes;
    }

    function nonce(bytes calldata _packet) internal pure returns (uint64) {
        // Nonce is part of the sender field? Actually in standard LayerZero V2, nonce is separate.
        // For simplicity, we extract nonce from a fixed offset. Adjust as needed.
        // In the original code, nonce is extracted from the packet. We'll assume it's at offset 68.
        uint256 constant NONCE_OFFSET = 68;
        require(_packet.length >= NONCE_OFFSET + 8, "PacketV1Codec: invalid packet length");
        uint64 nonceValue;
        assembly {
            nonceValue := calldataload(add(_packet.offset, NONCE_OFFSET))
        }
        return nonceValue;
    }

    function dstEid(bytes calldata _packet) internal pure returns (uint32) {
        require(_packet.length >= DST_EID_OFFSET + 4, "PacketV1Codec: invalid packet length");
        uint32 eid;
        assembly {
            eid := calldataload(add(_packet.offset, DST_EID_OFFSET))
        }
        return eid;
    }

    function receiverB20(bytes calldata _packet) internal pure returns (address) {
        require(_packet.length >= RECEIVER_OFFSET + 20, "PacketV1Codec: invalid packet length");
        address receiverAddress;
        assembly {
            receiverAddress := calldataload(add(_packet.offset, RECEIVER_OFFSET))
        }
        return receiverAddress;
    }

    function guid(bytes calldata _packet) internal pure returns (bytes32) {
        require(_packet.length >= GUID_OFFSET + 32, "PacketV1Codec: invalid packet length");
        bytes32 guidValue;
        assembly {
            guidValue := calldataload(add(_packet.offset, GUID_OFFSET))
        }
        return guidValue;
    }

    function message(bytes calldata _packet) internal pure returns (bytes memory) {
        require(_packet.length >= MESSAGE_OFFSET, "PacketV1Codec: invalid packet length");
        uint256 messageLength = _packet.length - MESSAGE_OFFSET;
        bytes memory messageBytes = new bytes(messageLength);
        // Copy message bytes from calldata to memory
        for (uint256 i = 0; i < messageLength; i++) {
            messageBytes[i] = _packet[MESSAGE_OFFSET + i];
        }
        return messageBytes;
    }
}

// PacketDecoder library
library PacketDecoder {
    using PacketV1Codec for bytes;

    function decode(bytes calldata _packet) internal pure returns (InboundPacket memory packet) {
        packet.origin = Origin(_packet.srcEid(), _packet.sender(), _packet.nonce());
        packet.dstEid = _packet.dstEid();
        packet.receiver = _packet.receiverB20();
        packet.guid = _packet.guid();
        packet.message = _packet.message();
    }

    function decode(
        bytes[] calldata _packets,
        uint256[] memory _packetMsgValues
    ) internal pure returns (InboundPacket[] memory packets) {
        packets = new InboundPacket[](_packets.length);
        for (uint256 i = 0; i < _packets.length; i++) {
            bytes calldata packet = _packets[i];
            packets[i] = PacketDecoder.decode(packet);
            packets[i].value = _packetMsgValues[i];
        }
    }
}