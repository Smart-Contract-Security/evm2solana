pragma solidity >=0.8.0;

library FixedPointMathLib {
    uint256 internal constant MAX_UINT256 = 2**256 - 1;
    uint256 internal constant WAD = 1e18;

    function mulWadDown(uint256 x, uint256 y) internal pure returns (uint256) {
        return mulDivDown(x, y, WAD);
    }

    function mulWadUp(uint256 x, uint256 y) internal pure returns (uint256) {
        return mulDivUp(x, y, WAD);
    }

    function divWadDown(uint256 x, uint256 y) internal pure returns (uint256) {
        return mulDivDown(x, WAD, y);
    }

    function divWadUp(uint256 x, uint256 y) internal pure returns (uint256) {
        return mulDivUp(x, WAD, y);
    }

    function mulDivDown(
        uint256 x,
        uint256 y,
        uint256 denominator
    ) internal pure returns (uint256 z) {
        require(denominator != 0 && (y == 0 || x <= MAX_UINT256 / y), "mulDivDown overflow");
        z = (x * y) / denominator;
    }

    function mulDivUp(
        uint256 x,
        uint256 y,
        uint256 denominator
    ) internal pure returns (uint256 z) {
        require(denominator != 0 && (y == 0 || x <= MAX_UINT256 / y), "mulDivUp overflow");
        uint256 product = x * y;
        z = product / denominator;
        if (product % denominator > 0) {
            z += 1;
        }
    }

    function rpow(
        uint256 x,
        uint256 n,
        uint256 scalar
    ) internal pure returns (uint256 z) {
        if (x == 0) {
            if (n == 0) {
                return scalar;
            } else {
                return 0;
            }
        }

        if (n % 2 == 0) {
            z = scalar;
        } else {
            z = x;
        }

        uint256 half = scalar / 2;
        n = n / 2;

        while (n > 0) {
            require(x <= type(uint128).max, "rpow overflow");

            uint256 xx = x * x;
            uint256 xxRound = xx + half;
            require(xxRound >= xx, "rpow overflow");

            x = xxRound / scalar;

            if (n % 2 != 0) {
                uint256 zx = z * x;
                require(z == 0 || zx / z == x, "rpow overflow");

                uint256 zxRound = zx + half;
                require(zxRound >= zx, "rpow overflow");

                z = zxRound / scalar;
            }

            n = n / 2;
        }
    }

    function sqrt(uint256 x) internal pure returns (uint256 z) {
        if (x == 0) return 0;

        uint256 y = x;
        z = 181;

        if (y >= 0x10000000000000000000000000000000000) {
            y = y >> 128;
            z = z << 64;
        }
        if (y >= 0x1000000000000000000) {
            y = y >> 64;
            z = z << 32;
        }
        if (y >= 0x10000000000) {
            y = y >> 32;
            z = z << 16;
        }
        if (y >= 0x1000000) {
            y = y >> 16;
            z = z << 8;
        }

        z = (z * (y + 65536)) >> 18;

        z = (z + x / z) >> 1;
        z = (z + x / z) >> 1;
        z = (z + x / z) >> 1;
        z = (z + x / z) >> 1;
        z = (z + x / z) >> 1;
        z = (z + x / z) >> 1;
        z = (z + x / z) >> 1;

        if (z > x / z) {
            z = z - 1;
        }
    }

    function unsafeMod(uint256 x, uint256 y) internal pure returns (uint256 z) {
        if (y == 0) return 0;
        z = x % y;
    }

    function unsafeDiv(uint256 x, uint256 y) internal pure returns (uint256 r) {
        if (y == 0) return 0;
        r = x / y;
    }

    function unsafeDivUp(uint256 x, uint256 y) internal pure returns (uint256 z) {
        if (y == 0) return 0;
        z = x / y;
        if (x % y > 0) {
            z += 1;
        }
    }
}