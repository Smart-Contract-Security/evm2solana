    function curveBaseInfo(CurveFactoryRequest params) external view returns (CurveBaseInfoResponse response);
    
    function curveFactory(CurveFactoryRequest params) external view returns (address);
    
    function curveStableFactoryV2(CurveFactoryRequest params) external view returns (CurveFilterResponseV2 response);
    
