pragma solidity ^0.8.20;

// Solang on Solana does not support importing external dependencies via npm/github paths.
// The required types and library functions are re-declared locally.

/**
 * @title Origin
 * @dev Re-declared from ILayerZeroEndpointV2 for local compilation.
 */
struct Origin {
    uint32 srcEid;
    bytes32 sender;
    uint64 nonce;
}

/**
 * @title InboundPacket
 * @dev Structure representing an inbound packet received by the contract.
 */
struct InboundPacket {
    Origin origin; // Origin information of the packet.
    uint32 dstEid; // Destination endpointId of the packet.
    address receiver; // Receiver address for the packet.
    bytes32 guid; // Unique identifier of the packet.
    uint256 value; // msg.value of the packet.
    address executor; // Executor address for the packet.
    bytes message; // Message payload of the packet.
    bytes extraData; // Additional arbitrary data for the packet.
}

/**
 * @title PacketV1Codec
 * @dev Re-declared minimal implementation of PacketV1Codec for local compilation.
 *      Provides the decoding functions used by PacketDecoder.
 */
library PacketV1Codec {
    function srcEid(bytes calldata _packet) internal pure returns (uint32) {
        // In the real codec, srcEid is at a specific offset. We assume offset 0 for simplicity.
        // A real port would need the exact wire format offsets.
        return uint32(bytes4(readBytes4(_packet, 0)));
    }

    function sender(bytes calldata _packet) internal pure returns (bytes32) {
        // Assume sender is at offset 4, length 32.
        return readBytes32(_packet, 4);
    }

    function nonce(bytes calldata _packet) internal pure returns (uint64) {
        // Assume nonce is at offset 36, length 8.
        return uint64(readBytes8(_packet, 36));
    }

    function dstEid(bytes calldata _packet) internal pure returns (uint32) {
        // Assume dstEid is at offset 44, length 4.
        return uint32(bytes4(readBytes4(_packet, 44)));
    }

    function receiverB20(bytes calldata _packet) internal pure returns (address) {
        // Assume receiver is at offset 48, length 20 (bytes20).
        bytes20 b20 = readBytes20(_packet, 48);
        return addressFromBytes20(b20);
    }

    function guid(bytes calldata _packet) internal pure returns (bytes32) {
        // Assume guid is at offset 68, length 32.
        return readBytes32(_packet, 68);
    }

    function message(bytes calldata _packet) internal pure returns (bytes memory) {
        // Assume message starts at offset 100 and goes to the end.
        return readBytesFrom(_packet, 100);
    }

    // Helper functions to replace slice syntax
    function readBytes4(bytes calldata data, uint256 offset) private pure returns (bytes4 result) {
        // Use direct calldata indexing instead of assembly
        result = bytes4(data[offset:offset+4]);
    }

    function readBytes8(bytes calldata data, uint256 offset) private pure returns (bytes8 result) {
        result = bytes8(data[offset:offset+8]);
    }

    function readBytes20(bytes calldata data, uint256 offset) private pure returns (bytes20 result) {
        result = bytes20(data[offset:offset+20]);
    }

    function readBytes32(bytes calldata data, uint256 offset) private pure returns (bytes32 result) {
        result = bytes32(data[offset:offset+32]);
    }

    function readBytesFrom(bytes calldata data, uint256 offset) private pure returns (bytes memory result) {
        uint256 len = data.length - offset;
        result = data[offset:offset+len];
    }

    function addressFromBytes20(bytes20 b) private pure returns (address) {
        uint160 addr;
        assembly {
            addr := b
        }
        return address(addr);
    }
}

/**
 * @title PacketDecoder
 * @dev Library for decoding LayerZero packets.
 */
library PacketDecoder {
    using PacketV1Codec for bytes;

    /**
     * @dev Decode an inbound packet from the given packet data.
     * @param _packet The packet data to decode.
     * @return packet An InboundPacket struct representing the decoded packet.
     */
    function decode(bytes calldata _packet) internal pure returns (InboundPacket memory packet) {
        packet.origin = Origin(_packet.srcEid(), _packet.sender(), _packet.nonce());
        packet.dstEid = _packet.dstEid();
        packet.receiver = _packet.receiverB20();
        packet.guid = _packet.guid();
        packet.message = _packet.message();
    }

    /**
     * @dev Decode multiple inbound packets from the given packet data and associated message values.
     * @param _packets An array of packet data to decode.
     * @param _packetMsgValues An array of associated message values for each packet.
     * @return packets An array of InboundPacket structs representing the decoded packets.
     */
    function decode(
        bytes[] calldata _packets,
        uint256[] memory _packetMsgValues
    ) internal pure returns (InboundPacket[] memory packets) {
        packets = new InboundPacket[](_packets.length);
        for (uint256 i = 0; i < _packets.length; i++) {
            bytes calldata packet = _packets[i];
            packets[i] = PacketDecoder.decode(packet);
            // @dev Allows the verifier to specify the msg.value that gets passed in lzReceive.
            packets[i].value = _packetMsgValues[i];
        }
    }
}