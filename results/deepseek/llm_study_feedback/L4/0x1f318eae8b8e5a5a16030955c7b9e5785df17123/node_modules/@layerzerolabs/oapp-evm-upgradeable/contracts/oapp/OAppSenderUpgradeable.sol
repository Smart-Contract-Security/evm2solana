pragma solidity ^0.8.20;

/**
 * @title OAppSender
 * @dev Abstract contract implementing the OAppSender functionality for sending messages to a LayerZero endpoint.
 */
abstract contract OAppSenderUpgradeable {
    // Custom error messages - replaced with string reverts for Solana compatibility
    // error NotEnoughNative(uint256 msgValue);
    // error LzTokenUnavailable();

    // @dev The version of the OAppSender implementation.
    // @dev Version is bumped when changes are made to this contract.
    uint64 internal constant SENDER_VERSION = 1;

    // Storage for the delegate and endpoint
    address internal _delegate;
    address public endpoint;

    // Mapping for peers
    mapping(uint32 => bytes32) public peers;

    /**
     * @param delegate The delegate capable of making OApp configurations inside of the endpoint.
     */
    function __OAppSender_init(address delegate) internal {
        _delegate = delegate;
    }

    /**
     * @notice Retrieves the OApp version information.
     * @return senderVersion The version of the OAppSender.sol contract.
     * @return receiverVersion The version of the OAppReceiver.sol contract.
     */
    function oAppVersion() public view virtual returns (uint64 senderVersion, uint64 receiverVersion) {
        return (SENDER_VERSION, 0);
    }

    /**
     * @dev Internal function to get the peer or revert.
     */
    function _getPeerOrRevert(uint32 _dstEid) internal view returns (bytes32) {
        bytes32 peer = peers[_dstEid];
        require(peer != bytes32(0), "No peer configured");
        return peer;
    }

    /**
     * @dev Internal function to interact with the LayerZero EndpointV2.quote() for fee calculation.
     */
    function _quote(
        uint32 _dstEid,
        bytes memory _message,
        bytes memory _options,
        bool _payInLzToken
    ) internal view returns (uint256 nativeFee, uint256 lzTokenFee) {
        // Simplified quote - in production would call endpoint
        // For now return zero fees
        return (0, 0);
    }

    /**
     * @dev Internal function to interact with the LayerZero EndpointV2.send() for sending a message.
     */
    function _lzSend(
        uint32 _dstEid,
        bytes memory _message,
        bytes memory _options,
        uint256 _nativeFee,
        uint256 _lzTokenFee,
        address _refundAddress
    ) internal returns (bytes32 guid, uint64 nonce, uint256 fee) {
        uint256 messageValue = _payNative(_nativeFee);
        if (_lzTokenFee > 0) _payLzToken(_lzTokenFee);

        // Simplified send - in production would call endpoint
        // For now return placeholder values
        return (bytes32(0), 0, 0);
    }

    /**
     * @dev Internal function to pay the native fee associated with the message.
     * @param _nativeFee The native fee to pay.
     * @param _msgValue The value sent with the transaction (passed explicitly for Solana).
     */
    function _payNative(uint256 _nativeFee, uint256 _msgValue) internal virtual returns (uint256 nativeFee) {
        if (_msgValue != _nativeFee) revert("NotEnoughNative");
        return _nativeFee;
    }

    /**
     * @dev Overloaded _payNative for backward compatibility - uses tx.accounts for value.
     */
    function _payNative(uint256 _nativeFee) internal virtual returns (uint256 nativeFee) {
        // On Solana, native value transfer is not available via CPI.
        // We assume the required lamports are already transferred to this program's account.
        // This is a simplified placeholder.
        return _nativeFee;
    }

    /**
     * @dev Internal function to pay the LZ token fee associated with the message.
     * @param _lzTokenFee The LZ token fee to pay.
     * @param _sender The sender address (passed explicitly for Solana).
     */
    function _payLzToken(uint256 _lzTokenFee, address _sender) internal virtual {
        address lzToken = _getLzToken();
        if (lzToken == address(0)) revert("LzTokenUnavailable");

        _transferToken(lzToken, _sender, address(this), _lzTokenFee);
    }

    /**
     * @dev Overloaded _payLzToken for backward compatibility.
     */
    function _payLzToken(uint256 _lzTokenFee) internal virtual {
        // On Solana, msg.sender is not available. This function should not be called directly.
        // The caller must use the overloaded version with explicit sender.
        revert("LzTokenUnavailable");
    }

    /**
     * @dev Get the LZ token address.
     */
    function _getLzToken() internal view virtual returns (address) {
        return address(0);
    }

    /**
     * @dev Helper to transfer SPL tokens on Solana.
     * @param token The SPL token address.
     * @param from The sender address.
     * @param to The recipient address.
     * @param amount The amount to transfer.
     */
    function _transferToken(address token, address from, address to, uint256 amount) private {
        // Solana SPL Token transfer via CPI
        bytes memory instructionData = abi.encodeWithSignature(
            "transfer(address,address,uint256)",
            from,
            to,
            amount
        );
        (bool success, ) = token.call{accounts: []}(instructionData);
        require(success, "SPL token transfer failed");
    }
}