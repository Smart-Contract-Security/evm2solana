pragma solidity ^0.8.24;

import {ECDSA} from "./ECDSA.sol";

library SignatureChecker {
    // IERC1271 interface definition inline since import not available
    // Solang does not support interface or abstract contract; use a regular contract with virtual functions
    contract IERC1271 {
        function isValidSignature(bytes32 hash, bytes memory signature) external view returns (bytes4 magicValue) {
            // Stub
        }
    }

    // IERC7913SignatureVerifier interface definition inline
    contract IERC7913SignatureVerifier {
        function verify(bytes memory signer, bytes32 hash, bytes memory signature) external view returns (bytes4 magicValue) {
            // Stub
        }
    }

    function isValidSignatureNow(address signer, bytes32 hash, bytes memory signature) internal view returns (bool) {
        // Solana: address.code.length is not supported. Use tryRecover for both EOA and contract cases.
        // We attempt ECDSA recovery first; if it matches, it's valid.
        // For contract wallets, we also try ERC1271 if ECDSA fails.
        (address recovered, ECDSA.RecoverError err, ) = ECDSA.tryRecover(hash, signature);
        if (err == ECDSA.RecoverError.NoError && recovered == signer) {
            return true;
        }
        // If ECDSA didn't match, try ERC1271 (contract signature validation)
        return isValidERC1271SignatureNow(signer, hash, signature);
    }

    function isValidERC1271SignatureNow(
        address signer,
        bytes32 hash,
        bytes memory signature
    ) internal view returns (bool) {
        // Solana: staticcall not available. Use tryRecover or assume call via low-level.
        // Since Solang doesn't support staticcall, we use a try-call pattern via address.call.
        // However, Solang for Solana does not support address.call either in the same way.
        // We'll use a workaround: encode the call and use the account's data.
        // For now, we'll implement a stub that returns false, as proper cross-contract calls
        // require Solana-specific syscalls. This is a limitation of the port.
        // In a real port, you'd use `account.execute` or similar.
        // We'll keep the logic but comment out the unsupported parts and return false.
        // Actually, Solang supports `address.call{value: ...}(...)`? No, not on Solana.
        // We'll use `abi.encodeCall` and then try to call via a low-level builtin if available.
        // Since it's not, we'll just return false for ERC1271 on Solana.
        // But to keep the code compilable, we'll use a dummy implementation.
        // The original code:
        // (bool success, bytes memory result) = signer.staticcall(abi.encodeCall(IERC1271.isValidSignature, (hash, signature)));
        // We replace with a call that always fails.
        return false;
    }

    function isValidSignatureNow(
        bytes memory signer,
        bytes32 hash,
        bytes memory signature
    ) internal view returns (bool) {
        if (signer.length < 20) {
            return false;
        } else if (signer.length == 20) {
            // Convert bytes20 to address
            address signerAddress = toAddress(signer);
            return isValidSignatureNow(signerAddress, hash, signature);
        } else {
            // For longer signers, we need IERC7913SignatureVerifier.verify
            // Not supported on Solana without cross-contract calls.
            return false;
        }
    }

    function areValidSignaturesNow(
        bytes32 hash,
        bytes[] memory signers,
        bytes[] memory signatures
    ) internal view returns (bool) {
        if (signers.length != signatures.length) return false;

        bytes32 lastId = bytes32(0);

        for (uint256 i = 0; i < signers.length; ++i) {
            bytes memory signer = signers[i];

            if (!isValidSignatureNow(signer, hash, signatures[i])) return false;

            bytes32 id = keccak256(signer);
            if (lastId < id) {
                lastId = id;
            } else {
                for (uint256 j = 0; j < i; ++j) {
                    if (id == keccak256(signers[j])) return false;
                }
            }
        }

        return true;
    }

    // Helper to convert bytes memory of length 20 to address
    function toAddress(bytes memory b) private pure returns (address) {
        require(b.length == 20, "Invalid address length");
        address addr;
        assembly {
            addr := mload(add(b, 20))
        }
        return addr;
    }
}