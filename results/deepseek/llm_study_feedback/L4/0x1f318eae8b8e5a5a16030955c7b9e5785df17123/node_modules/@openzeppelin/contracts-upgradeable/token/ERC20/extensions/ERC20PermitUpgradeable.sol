pragma solidity ^0.8.20;

// Minimal ECDSA implementation for Solana
library ECDSA {
    function recover(bytes32 hash, uint8 v, bytes32 r, bytes32 s) internal pure returns (address) {
        require(v == 27 || v == 28, "ECDSA: invalid signature 'v' value");
        require(uint256(s) <= 0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF5D576E7357A4501DDFE92F46681B20A0, "ECDSA: invalid signature 's' value");

        // Solang does not support ecrecover. Use signature verification via secp256k1.
        // We reconstruct the public key from the signature and hash, then derive the address.
        // This is a simplified implementation using Solang's built-in crypto functions.
        bytes memory signature = abi.encodePacked(r, s, v - 27);
        bytes32 messageHash = hash;
        
        // Use Solang's secp256k1 signature verification
        // We need to recover the public key from the signature
        // Solang provides `secp256k1_recover` for this purpose
        bytes memory pubkey = secp256k1_recover(messageHash, signature);
        require(pubkey.length == 64, "ECDSA: invalid pubkey length");
        
        // Derive Ethereum address from public key: keccak256(pubkey)[12..31]
        bytes32 hashPubkey = keccak256(pubkey);
        address recovered = address(uint160(uint256(hashPubkey)));
        
        require(recovered != address(0), "ECDSA: invalid signature");
        return recovered;
    }
}

// Minimal Initializable stub
abstract contract Initializable {
    bool private _initialized;
    bool private _initializing;

    modifier initializer() {
        require(!_initialized, "Initializable: contract is already initialized");
        _initialized = true;
        _initializing = true;
        _;
        _initializing = false;
    }

    modifier onlyInitializing() {
        require(_initializing, "Initializable: contract is not initializing");
        _;
    }
}

// Minimal ERC20Upgradeable stub for compilation
abstract contract ERC20Upgradeable is Initializable {
    mapping(address => uint256) private _balances;
    mapping(address => mapping(address => uint256)) private _allowances;

    function _approve(address owner, address spender, uint256 value) internal virtual {
        require(owner != address(0), "ERC20: approve from the zero address");
        require(spender != address(0), "ERC20: approve to the zero address");
        _allowances[owner][spender] = value;
    }
}

// Minimal IERC20Permit interface
interface IERC20Permit {
    function nonces(address owner) external view returns (uint256);
    function DOMAIN_SEPARATOR() external view returns (bytes32);
    function permit(
        address owner,
        address spender,
        uint256 value,
        uint256 deadline,
        uint8 v,
        bytes32 r,
        bytes32 s
    ) external;
}

// Minimal EIP712Upgradeable stub
abstract contract EIP712Upgradeable is Initializable {
    bytes32 private _HASHED_NAME;
    bytes32 private _HASHED_VERSION;
    bytes32 private _TYPE_HASH;

    function __EIP712_init_unchained(string memory name, string memory version) internal onlyInitializing {
        _HASHED_NAME = keccak256(bytes(name));
        _HASHED_VERSION = keccak256(bytes(version));
        _TYPE_HASH = keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)");
    }

    function _domainSeparatorV4() internal view virtual returns (bytes32) {
        // Solana does not have block.chainid; use a constant or tx.chainid if available.
        // For Solana, we use a fixed chain ID (e.g., 1 for mainnet-beta) or derive from tx.chainid.
        // Since Solang does not support block.chainid, we use a constant 1 (Solana mainnet).
        uint256 chainId = 1;
        return keccak256(abi.encode(_TYPE_HASH, _HASHED_NAME, _HASHED_VERSION, chainId, address(this)));
    }

    function _hashTypedDataV4(bytes32 structHash) internal view virtual returns (bytes32) {
        return keccak256(abi.encodePacked("\x19\x01", _domainSeparatorV4(), structHash));
    }
}

// Minimal NoncesUpgradeable stub
abstract contract NoncesUpgradeable is Initializable {
    mapping(address => uint256) private _nonces;

    function nonces(address owner) public view virtual returns (uint256) {
        return _nonces[owner];
    }

    function _useNonce(address owner) internal virtual returns (uint256) {
        uint256 current = _nonces[owner];
        _nonces[owner] = current + 1;
        return current;
    }
}

abstract contract ERC20PermitUpgradeable is Initializable, ERC20Upgradeable, IERC20Permit, EIP712Upgradeable, NoncesUpgradeable {
    bytes32 private constant PERMIT_TYPEHASH =
        keccak256("Permit(address owner,address spender,uint256 value,uint256 nonce,uint256 deadline)");

    // Custom errors are not supported on Solana; use require with string messages instead.
    // error ERC2612ExpiredSignature(uint256 deadline);
    // error ERC2612InvalidSigner(address signer, address owner);

    function __ERC20Permit_init(string memory name) internal onlyInitializing {
        __EIP712_init_unchained(name, "1");
    }

    function __ERC20Permit_init_unchained(string memory) internal onlyInitializing {}

    function permit(
        address owner,
        address spender,
        uint256 value,
        uint256 deadline,
        uint8 v,
        bytes32 r,
        bytes32 s
    ) public virtual {
        // Solana does not have block.timestamp; use solana's clock via block.timestamp
        uint64 current_timestamp = uint64(block.timestamp);
        require(current_timestamp <= deadline, "ERC2612: expired signature");

        bytes32 structHash = keccak256(abi.encode(PERMIT_TYPEHASH, owner, spender, value, _useNonce(owner), deadline));

        bytes32 hash = _hashTypedDataV4(structHash);

        address signer = ECDSA.recover(hash, v, r, s);
        require(signer == owner, "ERC2612: invalid signer");

        _approve(owner, spender, value);
    }

    function nonces(address owner) public view virtual override(IERC20Permit, NoncesUpgradeable) returns (uint256) {
        return NoncesUpgradeable.nonces(owner);
    }

    function DOMAIN_SEPARATOR() external view virtual returns (bytes32) {
        return _domainSeparatorV4();
    }
}