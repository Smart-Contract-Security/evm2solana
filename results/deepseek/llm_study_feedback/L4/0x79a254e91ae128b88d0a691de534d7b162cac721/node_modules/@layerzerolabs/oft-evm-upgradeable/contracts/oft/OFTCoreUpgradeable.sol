pragma solidity ^0.8.20;

// Solang does not support imports from external packages. We define all needed types and interfaces locally.

// --- Interfaces and Types ---

interface IOAppMsgInspector {
    function inspect(bytes calldata message, bytes calldata options) external view;
}

interface IOFT {
    function oftVersion() external view returns (bytes4 interfaceId, uint64 version);
}

struct SendParam {
    uint32 dstEid;
    bytes32 to;
    uint256 amountLD;
    uint256 minAmountLD;
    bytes extraOptions;
    bytes composeMsg;
}

struct OFTLimit {
    uint256 minAmountLD;
    uint256 maxAmountLD;
}

struct OFTReceipt {
    uint256 amountSentLD;
    uint256 amountReceivedLD;
}

struct OFTFeeDetail {
    uint256 reserved;
}

struct MessagingReceipt {
    bytes32 guid;
    uint64 nonce;
    MessagingFee fee;
}

struct MessagingFee {
    uint256 nativeFee;
    uint256 lzTokenFee;
}

struct Origin {
    uint32 srcEid;
    bytes32 sender;
    uint64 nonce;
}

// --- Errors ---
// Solang does not support custom errors with revert. Use string revert messages instead.
// error InvalidLocalDecimals();
// error AmountSDOverflowed(uint256 amountSD);
// error SlippageExceeded(uint256 amountReceivedLD, uint256 minAmountLD);

// --- Libraries ---

library OFTMsgCodec {
    function encode(
        bytes32 to,
        uint64 amountSD,
        bytes memory composeMsg
    ) internal pure returns (bytes memory message, bool hasCompose) {
        hasCompose = composeMsg.length > 0;
        message = abi.encodePacked(to, amountSD, composeMsg);
    }

    function sendTo(bytes calldata message) internal pure returns (bytes32) {
        bytes32 result;
        for (uint256 i = 0; i < 32; i++) {
            result |= bytes32(uint256(uint8(message[i])) << ((31 - i) * 8));
        }
        return result;
    }

    function amountSD(bytes calldata message) internal pure returns (uint64) {
        uint64 result;
        for (uint256 i = 32; i < 40; i++) {
            result |= uint64(uint8(message[i])) << ((i - 32) * 8);
        }
        return result;
    }

    function isComposed(bytes calldata message) internal pure returns (bool) {
        return message.length > 40;
    }

    function composeMsg(bytes calldata message) internal pure returns (bytes memory) {
        uint256 len = message.length - 40;
        bytes memory result = new bytes(len);
        for (uint256 i = 0; i < len; i++) {
            result[i] = message[40 + i];
        }
        return result;
    }
}

library OFTComposeMsgCodec {
    function encode(
        uint64 nonce,
        uint32 srcEid,
        uint256 amountReceivedLD,
        bytes memory composeMsg
    ) internal pure returns (bytes memory) {
        return abi.encodePacked(nonce, srcEid, amountReceivedLD, composeMsg);
    }
}

// --- Base contracts (simplified for Solang) ---

abstract contract OAppUpgradeable {
    address internal endpoint;

    constructor(address _endpoint) {
        endpoint = _endpoint;
    }

    function _lzSend(
        uint32 dstEid,
        bytes memory message,
        bytes memory options,
        MessagingFee memory fee,
        address refundAddress
    ) internal virtual returns (MessagingReceipt memory receipt) {
        // Stub: In a real implementation this would interact with the LayerZero endpoint.
        receipt.guid = bytes32(0);
        receipt.nonce = 0;
        receipt.fee = fee;
    }

    function _quote(
        uint32 dstEid,
        bytes memory message,
        bytes memory options,
        bool payInLzToken
    ) internal view virtual returns (MessagingFee memory fee) {
        // Stub
        fee.nativeFee = 0;
        fee.lzTokenFee = 0;
    }

    function peers(uint32 eid) internal view virtual returns (bytes32) {
        // Stub
        return bytes32(0);
    }

    function isPeer(uint32 eid, bytes32 peer) public view virtual returns (bool) {
        return peers(eid) == peer;
    }

    function combineOptions(
        uint32 dstEid,
        uint16 msgType,
        bytes calldata extraOptions
    ) internal view virtual returns (bytes memory) {
        return extraOptions;
    }

    function _lzReceive(
        Origin calldata origin,
        bytes32 guid,
        bytes calldata message,
        address executor,
        bytes calldata extraData
    ) internal virtual {}

    function _lzReceiveSimulate(
        Origin calldata origin,
        bytes32 guid,
        bytes calldata message,
        address executor,
        bytes calldata extraData
    ) internal virtual {
        _lzReceive(origin, guid, message, executor, extraData);
    }
}

abstract contract OAppPreCrimeSimulatorUpgradeable is OAppUpgradeable {
    function __OAppPreCrimeSimulator_init() internal {}
}

abstract contract OAppOptionsType3Upgradeable is OAppUpgradeable {
    function __OAppOptionsType3_init() internal {}
}

// --- Main Contract ---

abstract contract OFTCoreUpgradeable is
    IOFT,
    OAppUpgradeable,
    OAppPreCrimeSimulatorUpgradeable,
    OAppOptionsType3Upgradeable
{
    using OFTMsgCodec for bytes;

    struct OFTCoreStorage {
        address msgInspector;
    }

    bytes32 private constant OFT_CORE_STORAGE_LOCATION =
        0x41db8a78b0206aba5c54bcbfc2bda0d84082a84eb88e680379a57b9e9f653c00;

    uint256 public immutable decimalConversionRate;

    uint16 public constant SEND_TYPE = 1;
    uint16 public constant SEND_AND_CALL = 2;

    event MsgInspectorSet(address inspector);
    event OFTSent(bytes32 indexed guid, uint32 dstEid, address indexed from, uint256 amountSentLD, uint256 amountReceivedLD);
    event OFTReceived(bytes32 indexed guid, uint32 srcEid, address indexed to, uint256 amountReceivedLD);

    function _getOFTCoreStorage() internal pure returns (OFTCoreStorage storage $) {
        assembly {
            $.slot := OFT_CORE_STORAGE_LOCATION
        }
    }

    constructor(uint8 _localDecimals, address _endpoint) OAppUpgradeable(_endpoint) {
        if (_localDecimals < sharedDecimals()) revert("InvalidLocalDecimals");
        decimalConversionRate = 10 ** (_localDecimals - sharedDecimals());
    }

    function oftVersion() external pure virtual returns (bytes4 interfaceId, uint64 version) {
        // Solang does not support type(IOFT).interfaceId. Use a hardcoded value.
        return (bytes4(0x14e4ceea), 1);
    }

    function __OFTCore_init(address _delegate) internal {
        __OApp_init(_delegate);
        __OAppPreCrimeSimulator_init();
        __OAppOptionsType3_init();
    }

    function __OApp_init(address _delegate) internal virtual {}

    function __OFTCore_init_unchained() internal {}

    function msgInspector() public view returns (address) {
        OFTCoreStorage storage $ = _getOFTCoreStorage();
        return $.msgInspector;
    }

    function sharedDecimals() public pure virtual returns (uint8) {
        return 6;
    }

    function setMsgInspector(address _msgInspector) public virtual {
        OFTCoreStorage storage $ = _getOFTCoreStorage();
        $.msgInspector = _msgInspector;
        emit MsgInspectorSet(_msgInspector);
    }

    function quoteOFT(
        SendParam calldata _sendParam
    )
        external
        view
        virtual
        returns (OFTLimit memory oftLimit, OFTFeeDetail[] memory oftFeeDetails, OFTReceipt memory oftReceipt)
    {
        uint256 minAmountLD = 0;
        uint256 maxAmountLD = type(uint256).max;
        oftLimit = OFTLimit(minAmountLD, maxAmountLD);

        oftFeeDetails = new OFTFeeDetail[](0);

        (uint256 amountSentLD, uint256 amountReceivedLD) = _debitView(
            _sendParam.amountLD,
            _sendParam.minAmountLD,
            _sendParam.dstEid
        );
        oftReceipt = OFTReceipt(amountSentLD, amountReceivedLD);
    }

    function quoteSend(
        SendParam calldata _sendParam,
        bool _payInLzToken
    ) external view virtual returns (MessagingFee memory msgFee) {
        (, uint256 amountReceivedLD) = _debitView(_sendParam.amountLD, _sendParam.minAmountLD, _sendParam.dstEid);

        (bytes memory message, bytes memory options) = _buildMsgAndOptions(_sendParam, amountReceivedLD);

        return _quote(_sendParam.dstEid, message, options, _payInLzToken);
    }

    function send(
        SendParam calldata _sendParam,
        MessagingFee calldata _fee,
        address _refundAddress
    ) external payable virtual returns (MessagingReceipt memory msgReceipt, OFTReceipt memory oftReceipt) {
        return _send(_sendParam, _fee, _refundAddress);
    }

    function _send(
        SendParam calldata _sendParam,
        MessagingFee calldata _fee,
        address _refundAddress
    ) internal virtual returns (MessagingReceipt memory msgReceipt, OFTReceipt memory oftReceipt) {
        // Solana does not have tx.origin. Use msg.sender as a replacement.
        address sender = msg.sender;
        (uint256 amountSentLD, uint256 amountReceivedLD) = _debit(
            sender,
            _sendParam.amountLD,
            _sendParam.minAmountLD,
            _sendParam.dstEid
        );

        (bytes memory message, bytes memory options) = _buildMsgAndOptions(_sendParam, amountReceivedLD);

        msgReceipt = _lzSend(_sendParam.dstEid, message, options, _fee, _refundAddress);
        oftReceipt = OFTReceipt(amountSentLD, amountReceivedLD);

        emit OFTSent(msgReceipt.guid, _sendParam.dstEid, sender, amountSentLD, amountReceivedLD);
    }

    function _buildMsgAndOptions(
        SendParam calldata _sendParam,
        uint256 _amountLD
    ) internal view virtual returns (bytes memory message, bytes memory options) {
        bool hasCompose;
        (message, hasCompose) = OFTMsgCodec.encode(
            _sendParam.to,
            _toSD(_amountLD),
            _sendParam.composeMsg
        );
        uint16 msgType = hasCompose ? SEND_AND_CALL : SEND_TYPE;
        options = combineOptions(_sendParam.dstEid, msgType, _sendParam.extraOptions);

        OFTCoreStorage storage $ = _getOFTCoreStorage();
        address inspector = $.msgInspector;
        if (inspector != address(0)) IOAppMsgInspector(inspector).inspect(message, options);
    }

    function _lzReceive(
        Origin calldata _origin,
        bytes32 _guid,
        bytes calldata _message,
        address,
        bytes calldata
    ) internal virtual override {
        address toAddress = bytes32ToAddress(_message.sendTo());
        uint256 amountReceivedLD = _credit(toAddress, _toLD(_message.amountSD()), _origin.srcEid);

        if (_message.isComposed()) {
            bytes memory composeMsg = OFTComposeMsgCodec.encode(
                _origin.nonce,
                _origin.srcEid,
                amountReceivedLD,
                _message.composeMsg()
            );

            // endpoint.sendCompose(toAddress, _guid, 0, composeMsg);
        }

        emit OFTReceived(_guid, _origin.srcEid, toAddress, amountReceivedLD);
    }

    function _lzReceiveSimulate(
        Origin calldata _origin,
        bytes32 _guid,
        bytes calldata _message,
        address _executor,
        bytes calldata _extraData
    ) internal virtual override {
        _lzReceive(_origin, _guid, _message, _executor, _extraData);
    }

    function isPeer(uint32 _eid, bytes32 _peer) public view virtual override returns (bool) {
        return peers(_eid) == _peer;
    }

    function _removeDust(uint256 _amountLD) internal view virtual returns (uint256 amountLD) {
        return (_amountLD / decimalConversionRate) * decimalConversionRate;
    }

    function _toLD(uint64 _amountSD) internal view virtual returns (uint256 amountLD) {
        return _amountSD * decimalConversionRate;
    }

    function _toSD(uint256 _amountLD) internal view virtual returns (uint64 amountSD) {
        uint256 _amountSD = _amountLD / decimalConversionRate;
        if (_amountSD > type(uint64).max) revert("AmountSDOverflowed");
        return uint64(_amountSD);
    }

    function _debitView(
        uint256 _amountLD,
        uint256 _minAmountLD,
        uint32
    ) internal view virtual returns (uint256 amountSentLD, uint256 amountReceivedLD) {
        amountSentLD = _removeDust(_amountLD);
        amountReceivedLD = amountSentLD;

        if (amountReceivedLD < _minAmountLD) {
            revert("SlippageExceeded");
        }
    }

    function _debit(
        address _from,
        uint256 _amountLD,
        uint256 _minAmountLD,
        uint32 _dstEid
    ) internal virtual returns (uint256 amountSentLD, uint256 amountReceivedLD);

    function _credit(
        address _to,
        uint256 _amountLD,
        uint32 _srcEid
    ) internal virtual returns (uint256 amountReceivedLD);

    function bytes32ToAddress(bytes32 _bytes) internal pure returns (address) {
        return address(uint160(uint256(_bytes)));
    }
}