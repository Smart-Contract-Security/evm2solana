pragma solidity ^0.8.20;

library MessageHashUtils {
    function toEthSignedMessageHash(bytes32 messageHash) internal pure returns (bytes32 digest) {
        bytes memory prefix = "\x19Ethereum Signed Message:\n32";
        bytes memory result = new bytes(60);
        for (uint i = 0; i < 28; i++) {
            result[i] = prefix[i];
        }
        for (uint i = 0; i < 32; i++) {
            result[28 + i] = messageHash[i];
        }
        digest = keccak256(result);
    }

    function toEthSignedMessageHash(bytes memory message) internal pure returns (bytes32) {
        bytes memory prefix = "\x19Ethereum Signed Message:\n";
        bytes memory lenStr = bytes(uint2str(message.length));
        bytes memory combined = new bytes(prefix.length + lenStr.length + message.length);
        uint offset = 0;
        for (uint i = 0; i < prefix.length; i++) {
            combined[offset++] = prefix[i];
        }
        for (uint i = 0; i < lenStr.length; i++) {
            combined[offset++] = lenStr[i];
        }
        for (uint i = 0; i < message.length; i++) {
            combined[offset++] = message[i];
        }
        return keccak256(combined);
    }

    function toDataWithIntendedValidatorHash(address validator, bytes memory data) internal pure returns (bytes32) {
        bytes memory result = new bytes(2 + 20 + data.length);
        result[0] = 0x19;
        result[1] = 0x00;
        bytes20 validatorBytes = bytes20(uint160(validator));
        for (uint i = 0; i < 20; i++) {
            result[2 + i] = validatorBytes[i];
        }
        for (uint i = 0; i < data.length; i++) {
            result[22 + i] = data[i];
        }
        return keccak256(result);
    }

    function toDataWithIntendedValidatorHash(
        address validator,
        bytes32 messageHash
    ) internal pure returns (bytes32 digest) {
        bytes memory result = new bytes(54);
        result[0] = 0x19;
        result[1] = 0x00;
        bytes20 validatorBytes = bytes20(uint160(validator));
        for (uint i = 0; i < 20; i++) {
            result[2 + i] = validatorBytes[i];
        }
        for (uint i = 0; i < 32; i++) {
            result[22 + i] = messageHash[i];
        }
        digest = keccak256(result);
    }

    function toTypedDataHash(bytes32 domainSeparator, bytes32 structHash) internal pure returns (bytes32 digest) {
        bytes memory result = new bytes(66);
        result[0] = 0x19;
        result[1] = 0x01;
        for (uint i = 0; i < 32; i++) {
            result[2 + i] = domainSeparator[i];
        }
        for (uint i = 0; i < 32; i++) {
            result[34 + i] = structHash[i];
        }
        digest = keccak256(result);
    }

    function uint2str(uint _i) internal pure returns (string memory _uintAsString) {
        if (_i == 0) {
            return "0";
        }
        uint j = _i;
        uint len;
        while (j != 0) {
            len++;
            j /= 10;
        }
        bytes memory bstr = new bytes(len);
        uint k = len;
        while (_i != 0) {
            k = k - 1;
            uint8 temp = (48 + uint8(_i - _i / 10 * 10));
            bytes1 b1 = bytes1(temp);
            bstr[k] = b1;
            _i /= 10;
        }
        return string(bstr);
    }
}