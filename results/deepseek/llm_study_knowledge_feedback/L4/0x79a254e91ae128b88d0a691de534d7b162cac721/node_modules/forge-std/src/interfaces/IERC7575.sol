import {IERC165} from "./IERC165.sol";

interface IERC7575 is IERC165 {
    event Deposit(address sender, address owner, uint64 assets, uint64 shares);
    event Withdraw(
        address sender, address receiver, address owner, uint64 assets, uint64 shares
    );

    function asset() external view returns (address assetTokenAddress);

    function share() external view returns (address shareTokenAddress);

    function convertToShares(uint64 assets) external view returns (uint64 shares);

    function convertToAssets(uint64 shares) external view returns (uint64 assets);

    function totalAssets() external view returns (uint64 totalManagedAssets);

    function maxDeposit(address receiver) external view returns (uint64 maxAssets);

    function previewDeposit(uint64 assets) external view returns (uint64 shares);

    function deposit(uint64 assets, address receiver) external returns (uint64 shares);

    function maxMint(address receiver) external view returns (uint64 maxShares);

    function previewMint(uint64 shares) external view returns (uint64 assets);

    function mint(uint64 shares, address receiver) external returns (uint64 assets);

    function maxWithdraw(address owner) external view returns (uint64 maxAssets);

    function previewWithdraw(uint64 assets) external view returns (uint64 shares);

    function withdraw(uint64 assets, address receiver, address owner) external returns (uint64 shares);

    function maxRedeem(address owner) external view returns (uint64 maxShares);

    function previewRedeem(uint64 shares) external view returns (uint64 assets);

    function redeem(uint64 shares, address receiver, address owner) external returns (uint64 assets);
}

interface IERC7575Share is IERC165 {
    event VaultUpdate(address asset, address vault);

    function vault(address asset) external view returns (address);
}