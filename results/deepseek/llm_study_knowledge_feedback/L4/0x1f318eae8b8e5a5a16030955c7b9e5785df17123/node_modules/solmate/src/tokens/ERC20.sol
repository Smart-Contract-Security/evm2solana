import 'solana';

/// @notice Modern and gas efficient ERC20 + EIP-2612 implementation.
/// @author Solmate (https://github.com/transmissions11/solmate/blob/main/src/tokens/ERC20.sol)
/// @author Modified from Uniswap (https://github.com/Uniswap/uniswap-v2-core/blob/master/contracts/UniswapV2ERC20.sol)
/// @dev Do not manually set balances without updating totalSupply, as the sum of all user balances must not exceed it.
abstract contract ERC20 {
    /*//////////////////////////////////////////////////////////////
                                 EVENTS
    //////////////////////////////////////////////////////////////*/

    event Transfer(address indexed from, address indexed to, uint64 amount);

    event Approval(address indexed owner, address indexed spender, uint64 amount);

    /*//////////////////////////////////////////////////////////////
                            METADATA STORAGE
    //////////////////////////////////////////////////////////////*/

    string public name;

    string public symbol;

    uint8 public immutable decimals;

    /*//////////////////////////////////////////////////////////////
                              ERC20 STORAGE
    //////////////////////////////////////////////////////////////*/

    uint64 public totalSupply;

    mapping(address => uint64) public balanceOf;

    mapping(address => mapping(address => uint64)) public allowance;

    /*//////////////////////////////////////////////////////////////
                            EIP-2612 STORAGE
    //////////////////////////////////////////////////////////////*/

    uint64 internal immutable INITIAL_CHAIN_ID;

    bytes32 internal immutable INITIAL_DOMAIN_SEPARATOR;

    mapping(address => uint64) public nonces;

    /*//////////////////////////////////////////////////////////////
                               CONSTRUCTOR
    //////////////////////////////////////////////////////////////*/

    constructor(
        string memory _name,
        string memory _symbol,
        uint8 _decimals
    ) {
        name = _name;
        symbol = _symbol;
        decimals = _decimals;

        INITIAL_CHAIN_ID = 0;
        INITIAL_DOMAIN_SEPARATOR = computeDomainSeparator();
    }

    /*//////////////////////////////////////////////////////////////
                               ERC20 LOGIC
    //////////////////////////////////////////////////////////////*/

    function approve(address spender, uint64 amount) public virtual returns (bool) {
        address sender = tx.accounts.dataAccount.key;
        allowance[sender][spender] = amount;

        emit Approval(sender, spender, amount);

        return true;
    }

    function transfer(address to, uint64 amount) public virtual returns (bool) {
        address sender = tx.accounts.dataAccount.key;
        balanceOf[sender] -= amount;

        // Cannot overflow because the sum of all user
        // balances can't exceed the max uint64 value.
        unchecked {
            balanceOf[to] += amount;
        }

        emit Transfer(sender, to, amount);

        return true;
    }

    function transferFrom(
        address from,
        address to,
        uint64 amount
    ) public virtual returns (bool) {
        address spender = tx.accounts.dataAccount.key;
        uint64 allowed = allowance[from][spender]; // Saves gas for limited approvals.

        if (allowed != type(uint64).max) allowance[from][spender] = allowed - amount;

        balanceOf[from] -= amount;

        // Cannot overflow because the sum of all user
        // balances can't exceed the max uint64 value.
        unchecked {
            balanceOf[to] += amount;
        }

        emit Transfer(from, to, amount);

        return true;
    }

    /*//////////////////////////////////////////////////////////////
                             EIP-2612 LOGIC
    //////////////////////////////////////////////////////////////*/

    function permit(
        address owner,
        address spender,
        uint64 value,
        uint64 deadline,
        uint8 v,
        bytes32 r,
        bytes32 s
    ) public virtual {
        require(deadline >= uint64(block.timestamp), "PERMIT_DEADLINE_EXPIRED");

        // Unchecked because the only math done is incrementing
        // the owner's nonce which cannot realistically overflow.
        unchecked {
            bytes32 digest = keccak256(
                abi.encodePacked(
                    "\x19\x01",
                    DOMAIN_SEPARATOR(),
                    keccak256(
                        abi.encode(
                            keccak256(
                                "Permit(address owner,address spender,uint64 value,uint64 nonce,uint64 deadline)"
                            ),
                            owner,
                            spender,
                            value,
                            nonces[owner]++,
                            deadline
                        )
                    )
                )
            );

            // Solana does not have ecrecover, so we use signature verification via the Solana runtime
            // We need to verify the signature using the ed25519 or secp256k1 program
            // For this port, we assume the caller has already verified the signature off-chain
            // and we just check that the provided signer matches the owner
            // In a real implementation, you would use Solana's signature verification syscalls
            // Here we simply require that the signature is valid by checking the recovered address
            // Since ecrecover is not available, we use a simplified check
            // This is a placeholder - actual implementation would use Solana's sigVerify
            require(verifySignature(digest, v, r, s) == owner, "INVALID_SIGNER");

            allowance[owner][spender] = value;
        }

        emit Approval(owner, spender, value);
    }

    function verifySignature(bytes32 digest, uint8 v, bytes32 r, bytes32 s) internal pure returns (address) {
        // Placeholder for signature verification
        // On Solana, you would use the secp256k1 program or ed25519 program
        // For now, we return a dummy address that matches the expected behavior
        // In production, this should be replaced with actual signature verification
        return address(uint160(uint256(keccak256(abi.encodePacked(digest, v, r, s)))));
    }

    function DOMAIN_SEPARATOR() public view virtual returns (bytes32) {
        return INITIAL_DOMAIN_SEPARATOR;
    }

    function computeDomainSeparator() internal view virtual returns (bytes32) {
        return
            keccak256(
                abi.encode(
                    keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)"),
                    keccak256(bytes(name)),
                    keccak256("1"),
                    uint64(0),
                    address(this)
                )
            );
    }

    /*//////////////////////////////////////////////////////////////
                        INTERNAL MINT/BURN LOGIC
    //////////////////////////////////////////////////////////////*/

    function _mint(address to, uint64 amount) internal virtual {
        totalSupply += amount;

        // Cannot overflow because the sum of all user
        // balances can't exceed the max uint64 value.
        unchecked {
            balanceOf[to] += amount;
        }

        emit Transfer(address(0), to, amount);
    }

    function _burn(address from, uint64 amount) internal virtual {
        balanceOf[from] -= amount;

        // Cannot underflow because a user's balance
        // will never be larger than the total supply.
        unchecked {
            totalSupply -= amount;
        }

        emit Transfer(from, address(0), amount);
    }
}