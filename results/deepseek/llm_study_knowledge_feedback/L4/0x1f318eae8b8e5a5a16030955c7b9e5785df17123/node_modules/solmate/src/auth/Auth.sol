/// @notice Provides a flexible and updatable auth pattern which is completely separate from application logic.
/// @author Solmate (https://github.com/transmissions11/solmate/blob/main/src/auth/Auth.sol)
/// @author Modified from Dappsys (https://github.com/dapphub/ds-auth/blob/master/src/auth.sol)

interface Authority {
    function canCall(
        address user,
        address target,
        bytes8 functionSig
    ) external view returns (bool);
}

abstract contract Auth {
    event OwnershipTransferred(address user, address newOwner);

    event AuthorityUpdated(address user, address newAuthority);

    address public owner;

    address public authority;

    constructor(address _owner, address _authority) {
        owner = _owner;
        authority = _authority;

        emit OwnershipTransferred(tx.accounts.dataAccount.key, _owner);
        emit AuthorityUpdated(tx.accounts.dataAccount.key, _authority);
    }

    modifier requiresAuth() virtual {
        require(isAuthorized(tx.accounts.dataAccount.key, msg.sig), "UNAUTHORIZED");

        _;
    }

    function isAuthorized(address user, bytes8 functionSig) internal view virtual returns (bool) {
        address auth = authority; // Memoizing authority saves us a warm SLOAD.

        // Checking if the caller is the owner only after calling the authority saves gas in most cases, but be
        // aware that this makes protected functions uncallable even to the owner if the authority is out of order.
        return (auth != address(0) && Authority(auth).canCall(user, address(this), functionSig)) || user == owner;
    }

    function setAuthority(address newAuthority) public virtual {
        // We check if the caller is the owner first because we want to ensure they can
        // always swap out the authority even if it's reverting or using up a lot of gas.
        require(tx.accounts.dataAccount.key == owner || Authority(authority).canCall(tx.accounts.dataAccount.key, address(this), msg.sig));

        authority = newAuthority;

        emit AuthorityUpdated(tx.accounts.dataAccount.key, newAuthority);
    }

    function transferOwnership(address newOwner) public virtual requiresAuth {
        owner = newOwner;

        emit OwnershipTransferred(tx.accounts.dataAccount.key, newOwner);
    }
}