import {ERC20} from "../tokens/ERC20.sol";

library SafeTransferLib {
    function safeTransferETH(address to, uint64 amount) internal {
        require(to != address(0), "ETH_TRANSFER_FAILED");
        to.lamports += amount;
    }

    function safeTransferFrom(
        address token,
        address from,
        address to,
        uint64 amount
    ) internal {
        (bool success, bytes memory ret) = token.call{accounts: []}(abi.encodeWithSignature("transferFrom(address,address,uint64)", from, to, amount));
        require(success, "TRANSFER_FROM_FAILED");
    }

    function safeTransfer(
        address token,
        address to,
        uint64 amount
    ) internal {
        (bool success, bytes memory ret) = token.call{accounts: []}(abi.encodeWithSignature("transfer(address,uint64)", to, amount));
        require(success, "TRANSFER_FAILED");
    }

    function safeApprove(
        address token,
        address to,
        uint64 amount
    ) internal {
        (bool success, bytes memory ret) = token.call{accounts: []}(abi.encodeWithSignature("approve(address,uint64)", to, amount));
        require(success, "APPROVE_FAILED");
    }
}