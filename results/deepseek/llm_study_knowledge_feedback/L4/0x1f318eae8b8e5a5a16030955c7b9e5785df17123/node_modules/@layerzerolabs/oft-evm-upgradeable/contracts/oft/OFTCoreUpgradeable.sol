import { solana } from "solana";

// Define all required types and interfaces inline since imports are not available

// Origin struct
struct Origin {
    uint32 srcEid;
    bytes32 sender;
    uint64 nonce;
}

// SendParam struct
struct SendParam {
    uint32 dstEid;
    bytes32 to;
    uint64 amountLD;
    uint64 minAmountLD;
    bytes extraOptions;
    bytes composeMsg;
    bytes oftCmd;
}

// OFTLimit struct
struct OFTLimit {
    uint64 minAmountLD;
    uint64 maxAmountLD;
}

// OFTReceipt struct
struct OFTReceipt {
    uint64 amountSentLD;
    uint64 amountReceivedLD;
}

// OFTFeeDetail struct
struct OFTFeeDetail {
    uint64 feeAmountLD;
    bytes description;
}

// MessagingFee struct
struct MessagingFee {
    uint64 nativeFee;
    uint64 lzTokenFee;
}

// MessagingReceipt struct
struct MessagingReceipt {
    bytes32 guid;
    uint64 nonce;
    MessagingFee fee;
}

// IOFT interface
interface IOFT {
    function oftVersion() external view returns (bytes4 interfaceId, uint64 version);
    function quoteOFT(SendParam calldata _sendParam) external view returns (OFTLimit memory oftLimit, OFTFeeDetail[] memory oftFeeDetails, OFTReceipt memory oftReceipt);
    function quoteSend(SendParam calldata _sendParam, bool _payInLzToken) external view returns (MessagingFee memory msgFee);
    function send(SendParam calldata _sendParam, MessagingFee calldata _fee, address _refundAddress) external returns (MessagingReceipt memory msgReceipt, OFTReceipt memory oftReceipt);
}

// IOAppMsgInspector interface
interface IOAppMsgInspector {
    function inspect(bytes calldata message, bytes calldata options) external view;
}

// OFTMsgCodec library
library OFTMsgCodec {
    function encode(bytes32 _to, uint64 _amountSD, bytes memory _composeMsg) internal pure returns (bytes memory message, bool hasCompose) {
        hasCompose = _composeMsg.length > 0;
        message = abi.encodePacked(_to, _amountSD, _composeMsg);
    }

    function sendTo(bytes calldata _message) internal pure returns (bytes32) {
        return bytes32(_message[0:32]);
    }

    function amountSD(bytes calldata _message) internal pure returns (uint64) {
        return uint64(bytes8(_message[32:40]));
    }

    function isComposed(bytes calldata _message) internal pure returns (bool) {
        return _message.length > 40;
    }

    function composeMsg(bytes calldata _message) internal pure returns (bytes memory) {
        return _message[40:];
    }

    function bytes32ToAddress(bytes32 _b) internal pure returns (address) {
        return address(uint160(uint256(_b)));
    }
}

// OFTComposeMsgCodec library
library OFTComposeMsgCodec {
    function encode(uint64 _nonce, uint32 _srcEid, uint64 _amountLD, bytes memory _composeMsg) internal pure returns (bytes memory) {
        return abi.encodePacked(_nonce, _srcEid, _amountLD, _composeMsg);
    }
}

// Base OAppUpgradeable contract
abstract contract OAppUpgradeable {
    address public endpoint;
    mapping(uint32 => bytes32) public peers;

    event PeerSet(uint32 eid, bytes32 peer);

    constructor(address _endpoint) {
        endpoint = _endpoint;
    }

    function __OApp_init(address _delegate) internal {
        // Initialization logic
    }

    function _lzSend(
        uint32 _dstEid,
        bytes memory _message,
        bytes memory _options,
        MessagingFee memory _fee,
        address _refundAddress
    ) internal virtual returns (MessagingReceipt memory) {
        // Placeholder for LayerZero send logic
        return MessagingReceipt(bytes32(0), 0, _fee);
    }

    function _quote(
        uint32 _dstEid,
        bytes memory _message,
        bytes memory _options,
        bool _payInLzToken
    ) internal view virtual returns (MessagingFee memory) {
        // Placeholder for LayerZero quote logic
        return MessagingFee(0, 0);
    }

    function combineOptions(uint32 _dstEid, uint16 _msgType, bytes memory _extraOptions) internal pure virtual returns (bytes memory) {
        return abi.encodePacked(_msgType, _extraOptions);
    }

    function isPeer(uint32 _eid, bytes32 _peer) public view virtual returns (bool) {
        return peers[_eid] == _peer;
    }

    function setPeer(uint32 _eid, bytes32 _peer) public virtual {
        peers[_eid] = _peer;
        emit PeerSet(_eid, _peer);
    }
}

// OAppOptionsType3Upgradeable
abstract contract OAppOptionsType3Upgradeable {
    function __OAppOptionsType3_init() internal {}
}

// OAppPreCrimeSimulatorUpgradeable
abstract contract OAppPreCrimeSimulatorUpgradeable {
    function __OAppPreCrimeSimulator_init() internal {}
}

// Custom errors
error InvalidLocalDecimals();
error SlippageExceeded(uint64 amountReceivedLD, uint64 minAmountLD);
error AmountSDOverflowed(uint64 amountSD);

// Events
event OFTSent(bytes32 indexed guid, uint32 dstEid, address indexed fromAddress, uint64 amountSentLD, uint64 amountReceivedLD);
event OFTReceived(bytes32 indexed guid, uint32 srcEid, address indexed toAddress, uint64 amountReceivedLD);

abstract contract OFTCoreUpgradeable is
    IOFT,
    OAppUpgradeable,
    OAppPreCrimeSimulatorUpgradeable,
    OAppOptionsType3Upgradeable
{
    using OFTMsgCodec for bytes;
    using OFTMsgCodec for bytes32;

    struct OFTCoreStorage {
        address msgInspector;
    }

    bytes32 private constant OFT_CORE_STORAGE_LOCATION =
        0x41db8a78b0206aba5c54bcbfc2bda0d84082a84eb88e680379a57b9e9f653c00;

    uint64 public immutable decimalConversionRate;

    uint16 public constant SEND = 1;
    uint16 public constant SEND_AND_CALL = 2;

    event MsgInspectorSet(address inspector);

    function _getOFTCoreStorage() internal pure returns (OFTCoreStorage storage $) {
        assembly {
            $.slot := OFT_CORE_STORAGE_LOCATION
        }
    }

    constructor(uint8 _localDecimals, address _endpoint) OAppUpgradeable(_endpoint) {
        if (_localDecimals < sharedDecimals()) revert InvalidLocalDecimals();
        decimalConversionRate = uint64(10 ** (_localDecimals - sharedDecimals()));
    }

    function oftVersion() external pure virtual returns (bytes4 interfaceId, uint64 version) {
        return (IOFT.oftVersion.selector, 1);
    }

    function __OFTCore_init(address _delegate) internal {
        __OApp_init(_delegate);
        __OAppPreCrimeSimulator_init();
        __OAppOptionsType3_init();
    }

    function __OFTCore_init_unchained() internal {}

    function msgInspector() public view returns (address) {
        OFTCoreStorage storage $ = _getOFTCoreStorage();
        return $.msgInspector;
    }

    function sharedDecimals() public pure virtual returns (uint8) {
        return 6;
    }

    function setMsgInspector(address _msgInspector) public virtual {
        OFTCoreStorage storage $ = _getOFTCoreStorage();
        $.msgInspector = _msgInspector;
        emit MsgInspectorSet(_msgInspector);
    }

    function quoteOFT(
        SendParam calldata _sendParam
    )
        external
        view
        virtual
        returns (OFTLimit memory oftLimit, OFTFeeDetail[] memory oftFeeDetails, OFTReceipt memory oftReceipt)
    {
        uint64 minAmountLD = 0;
        uint64 maxAmountLD = type(uint64).max;
        oftLimit = OFTLimit(minAmountLD, maxAmountLD);

        oftFeeDetails = new OFTFeeDetail[](0);

        (uint64 amountSentLD, uint64 amountReceivedLD) = _debitView(
            _sendParam.amountLD,
            _sendParam.minAmountLD,
            _sendParam.dstEid
        );
        oftReceipt = OFTReceipt(amountSentLD, amountReceivedLD);
    }

    function quoteSend(
        SendParam calldata _sendParam,
        bool _payInLzToken
    ) external view virtual returns (MessagingFee memory msgFee) {
        (, uint64 amountReceivedLD) = _debitView(_sendParam.amountLD, _sendParam.minAmountLD, _sendParam.dstEid);

        (bytes memory message, bytes memory options) = _buildMsgAndOptions(_sendParam, amountReceivedLD);

        return _quote(_sendParam.dstEid, message, options, _payInLzToken);
    }

    function send(
        SendParam calldata _sendParam,
        MessagingFee calldata _fee,
        address _refundAddress
    ) external virtual returns (MessagingReceipt memory msgReceipt, OFTReceipt memory oftReceipt) {
        return _send(_sendParam, _fee, _refundAddress);
    }

    function _send(
        SendParam calldata _sendParam,
        MessagingFee calldata _fee,
        address _refundAddress
    ) internal virtual returns (MessagingReceipt memory msgReceipt, OFTReceipt memory oftReceipt) {
        (uint64 amountSentLD, uint64 amountReceivedLD) = _debit(
            tx.accounts.dataAccount.key,
            _sendParam.amountLD,
            _sendParam.minAmountLD,
            _sendParam.dstEid
        );

        (bytes memory message, bytes memory options) = _buildMsgAndOptions(_sendParam, amountReceivedLD);

        msgReceipt = _lzSend(_sendParam.dstEid, message, options, _fee, _refundAddress);
        oftReceipt = OFTReceipt(amountSentLD, amountReceivedLD);

        emit OFTSent(msgReceipt.guid, _sendParam.dstEid, tx.accounts.dataAccount.key, amountSentLD, amountReceivedLD);
    }

    function _buildMsgAndOptions(
        SendParam calldata _sendParam,
        uint64 _amountLD
    ) internal view virtual returns (bytes memory message, bytes memory options) {
        bool hasCompose;
        (message, hasCompose) = OFTMsgCodec.encode(
            _sendParam.to,
            _toSD(_amountLD),
            _sendParam.composeMsg
        );
        uint16 msgType = hasCompose ? SEND_AND_CALL : SEND;
        options = combineOptions(_sendParam.dstEid, msgType, _sendParam.extraOptions);

        OFTCoreStorage storage $ = _getOFTCoreStorage();

        address inspector = $.msgInspector;
        if (inspector != address(0)) IOAppMsgInspector(inspector).inspect(message, options);
    }

    function _lzReceive(
        Origin calldata _origin,
        bytes32 _guid,
        bytes calldata _message,
        address,
        bytes calldata
    ) internal virtual {
        address toAddress = _message.sendTo().bytes32ToAddress();
        uint64 amountReceivedLD = _credit(toAddress, _toLD(_message.amountSD()), _origin.srcEid);

        if (_message.isComposed()) {
            bytes memory composeMsg = OFTComposeMsgCodec.encode(
                _origin.nonce,
                _origin.srcEid,
                amountReceivedLD,
                _message.composeMsg()
            );

            // endpoint.sendCompose(toAddress, _guid, 0, composeMsg);
        }

        emit OFTReceived(_guid, _origin.srcEid, toAddress, amountReceivedLD);
    }

    function _lzReceiveSimulate(
        Origin calldata _origin,
        bytes32 _guid,
        bytes calldata _message,
        address _executor,
        bytes calldata _extraData
    ) internal virtual {
        _lzReceive(_origin, _guid, _message, _executor, _extraData);
    }

    function isPeer(uint32 _eid, bytes32 _peer) public view virtual override returns (bool) {
        return peers[_eid] == _peer;
    }

    function _removeDust(uint64 _amountLD) internal view virtual returns (uint64 amountLD) {
        return (_amountLD / decimalConversionRate) * decimalConversionRate;
    }

    function _toLD(uint64 _amountSD) internal view virtual returns (uint64 amountLD) {
        return _amountSD * decimalConversionRate;
    }

    function _toSD(uint64 _amountLD) internal view virtual returns (uint64 amountSD) {
        uint64 _amountSD = _amountLD / decimalConversionRate;
        if (_amountSD > type(uint64).max) revert AmountSDOverflowed(_amountSD);
        return _amountSD;
    }

    function _debitView(
        uint64 _amountLD,
        uint64 _minAmountLD,
        uint32
    ) internal view virtual returns (uint64 amountSentLD, uint64 amountReceivedLD) {
        amountSentLD = _removeDust(_amountLD);
        amountReceivedLD = amountSentLD;

        if (amountReceivedLD < _minAmountLD) {
            revert SlippageExceeded(amountReceivedLD, _minAmountLD);
        }
    }

    function _debit(
        address _from,
        uint64 _amountLD,
        uint64 _minAmountLD,
        uint32 _dstEid
    ) internal virtual returns (uint64 amountSentLD, uint64 amountReceivedLD);

    function _credit(
        address _to,
        uint64 _amountLD,
        uint32 _srcEid
    ) internal virtual returns (uint64 amountReceivedLD);
}