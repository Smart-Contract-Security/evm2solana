library AddressCast {
    function toBytes32(bytes calldata _addressBytes) internal pure returns (bytes32 result) {
        if (_addressBytes.length > 32) {
            revert("AddressCast_InvalidAddress");
        }
        result = bytes32(_addressBytes);
        unchecked {
            uint64 offset = 32 - uint64(_addressBytes.length);
            result = result >> (offset * 8);
        }
    }

    function toBytes32(address _address) internal pure returns (bytes32 result) {
        result = bytes32(uint256(uint160(_address)));
    }

    function toBytes(bytes32 _addressBytes32, uint64 _size) internal pure returns (bytes memory result) {
        if (_size == 0 || _size > 32) {
            revert("AddressCast_InvalidSizeForAddress");
        }
        result = new bytes(_size);
        unchecked {
            uint64 offset = 256 - _size * 8;
            bytes32 shifted = bytes32(uint256(_addressBytes32) << offset);
            for (uint64 i = 0; i < _size; i++) {
                result[i] = shifted[i];
            }
        }
    }

    function toAddress(bytes32 _addressBytes32) internal pure returns (address result) {
        result = address(uint160(uint256(_addressBytes32)));
    }

    function toAddress(bytes calldata _addressBytes) internal pure returns (address result) {
        if (_addressBytes.length != 32) {
            revert("AddressCast_InvalidAddress");
        }
        result = address(uint160(uint256(bytes32(_addressBytes))));
    }
}