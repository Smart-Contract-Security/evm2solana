import { Packet } from "../../interfaces/ISendLib.sol";

library PacketV1Codec {
    uint8 internal constant PACKET_VERSION = 1;

    // header (version + nonce + path)
    // version
    uint64 private constant PACKET_VERSION_OFFSET = 0;
    //    nonce
    uint64 private constant NONCE_OFFSET = 1;
    //    path
    uint64 private constant SRC_EID_OFFSET = 9;
    uint64 private constant SENDER_OFFSET = 13;
    uint64 private constant DST_EID_OFFSET = 45;
    uint64 private constant RECEIVER_OFFSET = 49;
    // payload (guid + message)
    uint64 private constant GUID_OFFSET = 81; // keccak256(nonce + path)
    uint64 private constant MESSAGE_OFFSET = 113;

    function toBytes32(address _addr) private pure returns (bytes32) {
        return bytes32(uint256(uint160(_addr)));
    }

    function toAddress(bytes32 _b32) private pure returns (address) {
        return address(uint160(uint256(_b32)));
    }

    function encode(Packet memory _packet) internal pure returns (bytes memory encodedPacket) {
        encodedPacket = abi.encodePacked(
            PACKET_VERSION,
            _packet.nonce,
            _packet.srcEid,
            toBytes32(_packet.sender),
            _packet.dstEid,
            _packet.receiver,
            _packet.guid,
            _packet.message
        );
    }

    function encodePacketHeader(Packet memory _packet) internal pure returns (bytes memory) {
        return
            abi.encodePacked(
                PACKET_VERSION,
                _packet.nonce,
                _packet.srcEid,
                toBytes32(_packet.sender),
                _packet.dstEid,
                _packet.receiver
            );
    }

    function encodePayload(Packet memory _packet) internal pure returns (bytes memory) {
        return abi.encodePacked(_packet.guid, _packet.message);
    }

    function header(bytes calldata _packet) internal pure returns (bytes memory) {
        return _packet[0:GUID_OFFSET];
    }

    function version(bytes calldata _packet) internal pure returns (uint8) {
        return uint8(_packet[PACKET_VERSION_OFFSET]);
    }

    function nonce(bytes calldata _packet) internal pure returns (uint64) {
        bytes memory slice = _packet[NONCE_OFFSET:SRC_EID_OFFSET];
        uint64 result;
        assembly {
            result := mload(add(slice, 8))
        }
        return result;
    }

    function srcEid(bytes calldata _packet) internal pure returns (uint32) {
        bytes memory slice = _packet[SRC_EID_OFFSET:SENDER_OFFSET];
        uint32 result;
        assembly {
            result := mload(add(slice, 4))
        }
        return result;
    }

    function sender(bytes calldata _packet) internal pure returns (bytes32) {
        bytes memory slice = _packet[SENDER_OFFSET:DST_EID_OFFSET];
        bytes32 result;
        assembly {
            result := mload(add(slice, 32))
        }
        return result;
    }

    function senderAddressB20(bytes calldata _packet) internal pure returns (address) {
        return toAddress(sender(_packet));
    }

    function dstEid(bytes calldata _packet) internal pure returns (uint32) {
        bytes memory slice = _packet[DST_EID_OFFSET:RECEIVER_OFFSET];
        uint32 result;
        assembly {
            result := mload(add(slice, 4))
        }
        return result;
    }

    function receiver(bytes calldata _packet) internal pure returns (bytes32) {
        bytes memory slice = _packet[RECEIVER_OFFSET:GUID_OFFSET];
        bytes32 result;
        assembly {
            result := mload(add(slice, 32))
        }
        return result;
    }

    function receiverB20(bytes calldata _packet) internal pure returns (address) {
        return toAddress(receiver(_packet));
    }

    function guid(bytes calldata _packet) internal pure returns (bytes32) {
        bytes memory slice = _packet[GUID_OFFSET:MESSAGE_OFFSET];
        bytes32 result;
        assembly {
            result := mload(add(slice, 32))
        }
        return result;
    }

    function message(bytes calldata _packet) internal pure returns (bytes memory) {
        return _packet[MESSAGE_OFFSET:];
    }

    function payload(bytes calldata _packet) internal pure returns (bytes memory) {
        return _packet[GUID_OFFSET:];
    }

    function payloadHash(bytes calldata _packet) internal pure returns (bytes32) {
        return keccak256(payload(_packet));
    }
}