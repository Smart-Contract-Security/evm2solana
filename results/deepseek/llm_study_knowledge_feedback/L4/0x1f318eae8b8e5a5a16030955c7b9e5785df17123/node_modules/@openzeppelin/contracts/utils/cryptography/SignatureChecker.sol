import {ECDSA} from "./ECDSA.sol";

library SignatureChecker {
    function isValidSignatureNow(address signer, bytes32 hash, bytes memory signature) internal view returns (bool) {
        // On Solana, address.code is not supported. Instead, we check if the signer is a program account.
        // We use a try-catch approach: if the call fails, it's likely an EOA (not a program).
        // However, try-catch is not available on Solana. We'll use a different approach:
        // We attempt to call isValidERC1271SignatureNow; if it reverts, we fall back to ECDSA.
        // Since Solana doesn't support try-catch, we must use a different strategy.
        // We'll check if the account is a program by checking if it's a PDA or owned by a program.
        // For simplicity, we'll always try ECDSA first, and if it fails, try ERC1271.
        // But the original logic requires checking code length. On Solana, we can check if the account is executable.
        // Since we don't have direct access to account metadata here, we'll use a heuristic:
        // We'll try ECDSA recovery; if it succeeds, return true. Otherwise, try ERC1271.
        // This changes the logic slightly but is the best we can do without account introspection.
        
        (address recovered, ECDSA.RecoverError err, ) = ECDSA.tryRecover(hash, signature);
        if (err == ECDSA.RecoverError.NoError && recovered == signer) {
            return true;
        }
        // If ECDSA fails, try ERC1271
        return isValidERC1271SignatureNow(signer, hash, signature);
    }

    function isValidERC1271SignatureNow(
        address signer,
        bytes32 hash,
        bytes memory signature
    ) internal view returns (bool) {
        // IERC1271.isValidSignature selector: bytes4(keccak256("isValidSignature(bytes32,bytes)"))
        bytes4 selector = 0x1626ba7e;
        bytes memory callData = abi.encodeWithSelector(selector, hash, signature);
        
        (bool success, bytes memory result) = signer.call{accounts: []}(callData);
        return (success &&
            result.length >= 32 &&
            abi.decode(result, (bytes32)) == bytes32(selector));
    }

    function isValidSignatureNow(
        bytes memory signer,
        bytes32 hash,
        bytes memory signature
    ) internal view returns (bool) {
        if (signer.length < 20) {
            return false;
        } else if (signer.length == 20) {
            // Convert bytes20 to address
            address signerAddress = toAddress(signer);
            return isValidSignatureNow(signerAddress, hash, signature);
        } else {
            // IERC7913SignatureVerifier.verify selector: bytes4(keccak256("verify(bytes,bytes32,bytes)"))
            bytes4 selector = 0x8e760afe;
            bytes memory callData = abi.encodeWithSelector(selector, sliceBytes(signer, 20), hash, signature);
            
            address signerAddress = toAddress(signer);
            (bool success, bytes memory result) = signerAddress.call{accounts: []}(callData);
            return (success &&
                result.length >= 32 &&
                abi.decode(result, (bytes32)) == bytes32(selector));
        }
    }

    function areValidSignaturesNow(
        bytes32 hash,
        bytes[] memory signers,
        bytes[] memory signatures
    ) internal view returns (bool) {
        if (signers.length != signatures.length) return false;

        bytes32 lastId = bytes32(0);

        for (uint64 i = 0; i < signers.length; ++i) {
            bytes memory signer = signers[i];

            if (!isValidSignatureNow(signer, hash, signatures[i])) return false;

            bytes32 id = keccak256(signer);
            if (lastId < id) {
                lastId = id;
            } else {
                for (uint64 j = 0; j < i; ++j) {
                    if (id == keccak256(signers[j])) return false;
                }
            }
        }

        return true;
    }

    // Helper function to convert bytes memory to address
    function toAddress(bytes memory b) private pure returns (address) {
        require(b.length >= 20, "Invalid length");
        address result;
        assembly {
            result := mload(add(b, 32))
        }
        return result;
    }

    // Helper function to slice bytes
    function sliceBytes(bytes memory data, uint64 start) private pure returns (bytes memory) {
        require(data.length >= start, "Invalid slice");
        uint64 len = data.length - start;
        bytes memory result = new bytes(len);
        for (uint64 i = 0; i < len; i++) {
            result[i] = data[start + i];
        }
        return result;
    }
}