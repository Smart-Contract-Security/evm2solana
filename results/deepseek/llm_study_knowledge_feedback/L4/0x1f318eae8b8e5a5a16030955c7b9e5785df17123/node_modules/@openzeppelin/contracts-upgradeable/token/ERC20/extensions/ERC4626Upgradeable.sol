import {Initializable} from "../../../proxy/utils/Initializable.sol";

abstract contract ERC4626Upgradeable is Initializable {
    struct ERC4626Storage {
        address _asset;
        uint8 _underlyingDecimals;
    }

    bytes32 private constant ERC4626StorageLocation = 0x0773e532dfede91f04b12a73d3d2acd361424f41f76b4fb79f090161e36b4e00;

    function _getERC4626Storage() private view returns (ERC4626Storage storage $) {
        assembly {
            $.slot := ERC4626StorageLocation
        }
    }

    function __ERC4626_init(address asset_) internal onlyInitializing {
        __ERC4626_init_unchained(asset_);
    }

    function __ERC4626_init_unchained(address asset_) internal onlyInitializing {
        ERC4626Storage storage $ = _getERC4626Storage();
        (bool success, uint8 assetDecimals) = _tryGetAssetDecimals(asset_);
        $._underlyingDecimals = success ? assetDecimals : 18;
        $._asset = asset_;
    }

    function _tryGetAssetDecimals(address asset_) private view returns (bool ok, uint8 assetDecimals) {
        (bool success, bytes memory encodedDecimals) = asset_.staticcall(
            abi.encodeWithSignature("decimals()")
        );
        if (success && encodedDecimals.length >= 32) {
            uint256 returnedDecimals = abi.decode(encodedDecimals, (uint256));
            if (returnedDecimals <= type(uint8).max) {
                return (true, uint8(returnedDecimals));
            }
        }
        return (false, 0);
    }

    function decimals() public view virtual returns (uint8) {
        ERC4626Storage storage $ = _getERC4626Storage();
        return $._underlyingDecimals + _decimalsOffset();
    }

    function asset() public view virtual returns (address) {
        ERC4626Storage storage $ = _getERC4626Storage();
        return $._asset;
    }

    function totalAssets() public view virtual returns (uint64) {
        (bool success, bytes memory data) = asset().staticcall(abi.encodeWithSignature("balanceOf(address)", address(this)));
        require(success, "balanceOf failed");
        return abi.decode(data, (uint64));
    }

    function convertToShares(uint64 assets) public view virtual returns (uint64) {
        return _convertToShares(assets, false);
    }

    function convertToAssets(uint64 shares) public view virtual returns (uint64) {
        return _convertToAssets(shares, false);
    }

    function maxDeposit(address) public view virtual returns (uint64) {
        return type(uint64).max;
    }

    function maxMint(address) public view virtual returns (uint64) {
        return type(uint64).max;
    }

    function maxWithdraw(address owner) public view virtual returns (uint64) {
        return _convertToAssets(balanceOf(owner), false);
    }

    function maxRedeem(address owner) public view virtual returns (uint64) {
        return balanceOf(owner);
    }

    function previewDeposit(uint64 assets) public view virtual returns (uint64) {
        return _convertToShares(assets, false);
    }

    function previewMint(uint64 shares) public view virtual returns (uint64) {
        return _convertToAssets(shares, true);
    }

    function previewWithdraw(uint64 assets) public view virtual returns (uint64) {
        return _convertToShares(assets, true);
    }

    function previewRedeem(uint64 shares) public view virtual returns (uint64) {
        return _convertToAssets(shares, false);
    }

    function deposit(uint64 assets, address receiver) public virtual returns (uint64) {
        uint64 maxAssets = maxDeposit(receiver);
        if (assets > maxAssets) {
            revert();
        }

        uint64 shares = previewDeposit(assets);
        _deposit(tx.accounts.dataAccount.key, receiver, assets, shares);

        return shares;
    }

    function mint(uint64 shares, address receiver) public virtual returns (uint64) {
        uint64 maxShares = maxMint(receiver);
        if (shares > maxShares) {
            revert();
        }

        uint64 assets = previewMint(shares);
        _deposit(tx.accounts.dataAccount.key, receiver, assets, shares);

        return assets;
    }

    function withdraw(uint64 assets, address receiver, address owner) public virtual returns (uint64) {
        uint64 maxAssets = maxWithdraw(owner);
        if (assets > maxAssets) {
            revert();
        }

        uint64 shares = previewWithdraw(assets);
        _withdraw(tx.accounts.dataAccount.key, receiver, owner, assets, shares);

        return shares;
    }

    function redeem(uint64 shares, address receiver, address owner) public virtual returns (uint64) {
        uint64 maxShares = maxRedeem(owner);
        if (shares > maxShares) {
            revert();
        }

        uint64 assets = previewRedeem(shares);
        _withdraw(tx.accounts.dataAccount.key, receiver, owner, assets, shares);

        return assets;
    }

    function _convertToShares(uint64 assets, bool roundUp) internal view virtual returns (uint64) {
        uint64 supply = totalSupply();
        uint64 offset = uint64(10) ** uint64(_decimalsOffset());
        uint64 total = totalAssets() + 1;
        if (roundUp) {
            return uint64((uint256(assets) * uint256(supply + offset) + uint256(total) - 1) / uint256(total));
        } else {
            return uint64((uint256(assets) * uint256(supply + offset)) / uint256(total));
        }
    }

    function _convertToAssets(uint64 shares, bool roundUp) internal view virtual returns (uint64) {
        uint64 total = totalAssets() + 1;
        uint64 supply = totalSupply();
        uint64 offset = uint64(10) ** uint64(_decimalsOffset());
        if (roundUp) {
            return uint64((uint256(shares) * uint256(total) + uint256(supply + offset) - 1) / uint256(supply + offset));
        } else {
            return uint64((uint256(shares) * uint256(total)) / uint256(supply + offset));
        }
    }

    function _deposit(address caller, address receiver, uint64 assets, uint64 shares) internal virtual {
        (bool success, ) = asset().call(abi.encodeWithSignature("transferFrom(address,address,uint64)", caller, address(this), assets));
        require(success, "transferFrom failed");
        _mint(receiver, shares);

        emit Deposit(caller, receiver, assets, shares);
    }

    function _withdraw(
        address caller,
        address receiver,
        address owner,
        uint64 assets,
        uint64 shares
    ) internal virtual {
        if (caller != owner) {
            _spendAllowance(owner, caller, shares);
        }

        _burn(owner, shares);
        (bool success, ) = asset().call(abi.encodeWithSignature("transfer(address,uint64)", receiver, assets));
        require(success, "transfer failed");

        emit Withdraw(caller, receiver, owner, assets, shares);
    }

    function _decimalsOffset() internal view virtual returns (uint8) {
        return 0;
    }

    function totalSupply() public view virtual returns (uint64);
    function balanceOf(address account) public view virtual returns (uint64);
    function _mint(address account, uint64 amount) internal virtual;
    function _burn(address account, uint64 amount) internal virtual;
    function _spendAllowance(address owner, address spender, uint64 amount) internal virtual;

    event Deposit(address indexed caller, address indexed owner, uint64 assets, uint64 shares);
    event Withdraw(address indexed caller, address indexed receiver, address indexed owner, uint64 assets, uint64 shares);
}