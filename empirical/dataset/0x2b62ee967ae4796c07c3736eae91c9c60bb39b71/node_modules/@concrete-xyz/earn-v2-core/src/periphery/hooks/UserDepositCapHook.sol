pragma solidity ^0.8.24;

import {IHook} from "../../interface/IHook.sol";
import {Ownable} from "@openzeppelin-contracts/access/Ownable.sol";
import {IERC4626} from "@openzeppelin-contracts/interfaces/IERC4626.sol";

/**
 * @title UserDepositCapHook
 * @notice Pre-deposit hook that enforces per-user deposit caps for a single vault
 * @dev This hook is deployed per vault. It tracks cumulative deposits per user and enforces the configured cap.
 * @author Blueprint Finance
 */
contract UserDepositCapHook is IHook, Ownable {
    // ─────────────────────────────────────────────────────────────────────────────
    // Errors
    // ─────────────────────────────────────────────────────────────────────────────

    error UserDepositLimitExceeded(address user, uint256 attemptedTotal, uint256 limit);
    error InvalidLimit(uint256 limit);
    error ZeroAddress();

    // ─────────────────────────────────────────────────────────────────────────────
    // Events
    // ─────────────────────────────────────────────────────────────────────────────

    event DepositCapSet(uint256 oldCap, uint256 newCap);

    // ─────────────────────────────────────────────────────────────────────────────
    // State Variables
    // ─────────────────────────────────────────────────────────────────────────────

    /// @notice The vault this hook is associated with
    IERC4626 internal immutable VAULT;

    /// @notice Per-user deposit cap for this vault (in asset terms)
    uint256 public userDepositCap;

    // ─────────────────────────────────────────────────────────────────────────────
    // Constructor
    // ─────────────────────────────────────────────────────────────────────────────

    /**
     * @notice Initializes the hook
     * @param _owner The owner address that can manage vault caps
     * @param _vault The vault address this hook is associated with
     */
    constructor(address _owner, address _vault) Ownable(_owner) {
        require(_vault != address(0), ZeroAddress());
        VAULT = IERC4626(_vault);
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // IHook — vault
    // ─────────────────────────────────────────────────────────────────────────────

    /// @notice Returns the vault address this hook is associated with
    function vault() external view returns (address) {
        return address(VAULT);
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Admin Functions
    // ─────────────────────────────────────────────────────────────────────────────

    /**
     * @notice Sets the per-user deposit cap for this vault
     * @param _depositCap The deposit cap for each user (in asset terms)
     */
    function setDepositCap(uint256 _depositCap) external onlyOwner {
        uint256 oldCap = userDepositCap;
        userDepositCap = _depositCap;
        emit DepositCapSet(oldCap, _depositCap);
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // View Functions
    // ─────────────────────────────────────────────────────────────────────────────

    /**
     * @notice Gets the per-user deposit cap for this vault
     * @return The deposit cap that applies to each user
     */
    function getUserDepositCap() public view returns (uint256) {
        return userDepositCap;
    }

    /**
     * @notice Checks if a user can deposit a given amount into this vault
     * @param _user The user (receiver) address
     * @param _additionalAssets The amount of assets to deposit
     * @return true if the user can deposit, reverts if the user cannot deposit
     */
    function canUserDeposit(address _user, uint256 _additionalAssets) external view returns (bool) {
        _checkDepositLimit(_user, _additionalAssets);
        return true;
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Hook Implementations - Pre Hooks
    // ─────────────────────────────────────────────────────────────────────────────

    /**
     * @notice Pre-deposit hook - validates deposit against user limit
     * @param sender The address initiating the deposit
     * @param assets The amount of assets being deposited
     * @param shares The amount of shares being minted
     * @param receiver The address that will receive the vault shares
     * @param totalAssets The total assets in the vault before this deposit
     */
    function preDeposit(address sender, uint256 assets, uint256 shares, address receiver, uint256 totalAssets)
        public
        view
        virtual
    {
        _checkDepositLimit(receiver, assets);
    }

    /**
     * @notice Pre-mint hook - validates mint against user limit
     * @param sender The address initiating the mint
     * @param assets The amount of assets to be deposited
     * @param shares The amount of shares being minted
     * @param receiver The address that will receive the vault shares
     * @param totalAssets The total assets in the vault before this mint
     */
    function preMint(address sender, uint256 assets, uint256 shares, address receiver, uint256 totalAssets)
        public
        view
        virtual
    {
        _checkDepositLimit(receiver, assets);
    }

    /// @notice Pre-withdraw hook - not implemented
    function preWithdraw(address, uint256, uint256, address, address, uint256) public pure virtual {}

    /// @notice Pre-redeem hook - not implemented
    function preRedeem(address, uint256, uint256, address, address, uint256) public pure virtual {}

    // ─────────────────────────────────────────────────────────────────────────────
    // Hook Implementations - Post Hooks
    // ─────────────────────────────────────────────────────────────────────────────

    /// @notice Post-deposit hook - not implemented
    function postDeposit(address, uint256, uint256, address, uint256) public pure virtual {}

    /// @notice Post-mint hook - not implemented
    function postMint(address, uint256, uint256, address, uint256) public pure virtual {}

    /// @notice Post-withdraw hook - not implemented
    function postWithdraw(address, uint256, uint256, address, uint256) public pure virtual {}

    /// @notice Post-redeem hook - not implemented
    function postRedeem(address, uint256, uint256, address, uint256) public pure virtual {}

    // ─────────────────────────────────────────────────────────────────────────────
    // Hook Implementations - Transfer Hooks
    // ─────────────────────────────────────────────────────────────────────────────

    /// @notice Pre-transfer hook - not implemented
    function preTransfer(address, address, address, uint256) public pure virtual {}

    /// @notice Post-transfer hook - not implemented
    function postTransfer(address, address, address, uint256) public pure virtual {}

    // ─────────────────────────────────────────────────────────────────────────────
    // Internal Functions
    // ─────────────────────────────────────────────────────────────────────────────

    /**
     * @notice Internal function to check if a deposit would exceed the user's cap
     * @param _receiver The address that will receive the shares
     * @param _additionalAssets The amount of assets being added
     */
    function _checkDepositLimit(address _receiver, uint256 _additionalAssets) internal view {
        uint256 depositCap_ = userDepositCap;
        uint256 userShares = VAULT.balanceOf(_receiver);
        uint256 currentAssetValue = VAULT.convertToAssets(userShares);
        uint256 newTotal = currentAssetValue + _additionalAssets;
        if (newTotal > depositCap_) {
            revert UserDepositLimitExceeded(_receiver, newTotal, depositCap_);
        }
    }
}

