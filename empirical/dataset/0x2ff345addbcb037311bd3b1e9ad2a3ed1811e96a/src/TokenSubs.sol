pragma solidity ^0.8.25;

import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/utils/math/Math.sol";
import "@openzeppelin/contracts/utils/Pausable.sol";
import "@uniswap/v3-core/contracts/interfaces/IUniswapV3Factory.sol";
import "@uniswap/v3-core/contracts/interfaces/IUniswapV3Pool.sol";
import "@uniswap/v3-periphery/contracts/interfaces/IQuoterV2.sol";
import "@uniswap/v3-periphery/contracts/interfaces/ISwapRouter.sol";

contract TokenSubs is Ownable, Pausable {
    // Wrapped native token
    address public immutable WETH;

    IUniswapV3Factory public immutable uniswapFactory;
    ISwapRouter public immutable uniswapRouter;
    IQuoterV2 public immutable uniswapQuoter;

    struct Subscription {
        uint160 id;                   // Random number generated by the frontend
        address merchant;
        address subscriber;
        string trackingInfo;          // Arbitrary string from the merchant
        uint8 intervalDays;
        uint256 price;                // Price in receiveToken
        bool cancelled;
        uint24 feePool;               // Uniswap fee tier to swap, chanegable by subscriber
        address payTokenAddress;      // Chanegable by subscriber
        address receiveTokenAddress;
        uint256 expiredAt;
    }

    uint256 public feeRate = 0.01e18; // Fee charged by TokenSubs
    uint24 public gasFeePool = 3000; // Fee tier to swap WETH (for gas cost estimation)

    mapping (uint256 id => Subscription) public subscriptions;
    mapping (address => uint256[] ids) public merchantSubscriptionIds;
    mapping (address => uint256[] ids) public subscriberSubscriptionIds;

    mapping (address => bool) public allowedPayTokens;
    mapping (address => bool) public allowedReceiveTokens;

    event SubscriptionCreated(
        uint160 indexed id,
        address indexed merchant,
        address indexed subscriber,
        address payTokenAddress,
        uint24 feePool
    );

    event SubscriptionChanged(
        uint160 indexed id,
        address indexed merchant,
        address indexed subscriber,
        address payTokenAddress,
        uint24 feePool
    );

    event SubscriptionRenewed(
        uint160 indexed id,
        address indexed merchant,
        address indexed subscriber,
        uint256 spentPayToken,
        uint256 expiredAt
    );

    event SubscriptionCancelled(
        uint160 indexed id,
        address indexed merchant,
        address indexed subscriber,
        address cancelledBy
    );

    constructor(
        address[] memory _allowedPayTokens, address[] memory _allowedReceiveTokens,
        address _uniswapFactory, address _uniswapRouter, address _uniswapQuoter,
        address _WETH
    ) Ownable(msg.sender) Pausable() {
        uniswapFactory = IUniswapV3Factory(_uniswapFactory);
        uniswapRouter = ISwapRouter(_uniswapRouter);
        uniswapQuoter = IQuoterV2(_uniswapQuoter);

        WETH = _WETH;

        for (uint256 i = 0; i < _allowedPayTokens.length; i++) {
            allowedPayTokens[_allowedPayTokens[i]] = true;
        }

        for (uint256 i = 0; i < _allowedReceiveTokens.length; i++) {
            allowedReceiveTokens[_allowedReceiveTokens[i]] = true;
        }
    }

    // @param maxPayAmount: set slippage for initial swap
    function subscribe(Subscription memory subs, uint256 maxPayAmount) external whenNotPaused {
        require(subs.id != 0, "Subscription id should not be 0");
        require(subscriptions[subs.id].id == 0, "Subscription id already exists");
        require(subs.intervalDays > 0, "Interval days must be greater than 0");
        require(subs.price > 0, "Price must be greater than 0");
        require(allowedPayTokens[subs.payTokenAddress], "payToken is not allowed");
        require(allowedReceiveTokens[subs.receiveTokenAddress], "receiveToken is not allowed");

        subs.subscriber = msg.sender;
        subs.cancelled = false;
        subs.expiredAt = 0;

        if (subs.feePool == 0) {
            subs.feePool = 3000;
        }

        subscriptions[subs.id] = subs;
        merchantSubscriptionIds[subs.merchant].push(subs.id);
        subscriberSubscriptionIds[subs.subscriber].push(subs.id);

        emit SubscriptionCreated(subs.id, subs.merchant, subs.subscriber, subs.payTokenAddress, subs.feePool);

        charge(subscriptions[subs.id], 0, maxPayAmount);
    }

    function getSubscription(uint256 id) external view returns (Subscription memory) {
        return subscriptions[id];
    }

    // @param participant: merchant or subscriber
    function getSubscriptions(address participant) external view returns (Subscription[] memory) {
        uint256[] memory subsAsMerchant = merchantSubscriptionIds[participant];
        uint256[] memory subsAsSubscriber = subscriberSubscriptionIds[participant];

        uint256 count = subsAsMerchant.length;

        // Deduplicate between merchant and subscriber
        for (uint256 i = 0; i < subsAsSubscriber.length; i++) {
            if (subscriptions[subsAsSubscriber[i]].merchant != participant) {
                count++;
            }
        }

        Subscription[] memory subs = new Subscription[](count);

        for (uint256 i = 0; i < subsAsMerchant.length; i++) {
            subs[i] = subscriptions[subsAsMerchant[i]];
        }

        uint256 index = subsAsMerchant.length;

        for (uint256 i = 0; i < subsAsSubscriber.length; i++) {
            if (subscriptions[subsAsSubscriber[i]].merchant != participant) {
                subs[index++] = subscriptions[subsAsSubscriber[i]];
            }
        }

        return subs;
    }

    // Will trigger a renewal if the subscription is expired or about to expire
    function setPayToken(uint256 id, address payTokenAddress, uint24 feePool, uint256 maxPayAmount) external whenNotPaused {
        require(allowedPayTokens[payTokenAddress], "payToken is not allowed");

        Subscription storage subs = subscriptions[id];

        require(msg.sender == subs.subscriber, "Only subscriber can change payToken");
        require(subs.id != 0, "Subscription does not exist");
        require(subs.cancelled == false, "Subscription is cancelled");

        subs.payTokenAddress = payTokenAddress;
        subs.feePool = feePool;

        emit SubscriptionChanged(subs.id, subs.merchant, subs.subscriber, subs.payTokenAddress, subs.feePool);

        if (subs.expiredAt <= block.timestamp + 1 days) {
            charge(subs, 0, maxPayAmount);
        }
    }

    // Can be called by anyone, no privileges
    function renew(uint256 id) external whenNotPaused {
        uint256 gasLeftBeginning = gasleft();

        Subscription storage subs = subscriptions[id];

        require(subs.id != 0, "Subscription does not exist");
        require(subs.expiredAt <= block.timestamp + 1 days, "Subscription is not expired within 1 day");
        require(subs.cancelled == false, "Subscription is cancelled");

        charge(subs, gasLeftBeginning, 0);
    }

    function cancel(uint256 id) external whenNotPaused {
        Subscription storage subs = subscriptions[id];

        require(subs.id != 0, "Subscription does not exist");
        require(subs.cancelled == false, "Subscription is cancelled");
        require(subs.merchant == msg.sender || subs.subscriber == msg.sender, "Only merchant or subscriber can cancel the subscription");

        subs.cancelled = true;

        emit SubscriptionCancelled(subs.id, subs.merchant, subs.subscriber, msg.sender);
    }

    // @dev The merchant pays for the gas cost and TokenSubs fee, the subscriber pays for the swap fee & slippage
    // @param gasLeftBeginning: gasleft() at the beginning of the transaction, 0 stands for not checking gas cost
    // @param maxPayAmount: max payToken amount can be spent, 0 stands for use TWAP 15 min + 0.5% slippage
    function charge(Subscription storage subs, uint256 gasLeftBeginning, uint256 maxPayAmount) internal {
        IERC20 payToken = IERC20(subs.payTokenAddress);
        IERC20 receiveToken = IERC20(subs.receiveTokenAddress);

        subs.expiredAt = (block.timestamp > subs.expiredAt ? block.timestamp : subs.expiredAt) + subs.intervalDays * 1 days;

        uint256 spentPayToken;
        uint256 ethPriceInPayToken;
        uint256 gasCost = 0;

        if (gasLeftBeginning != 0) {
            ethPriceInPayToken = getEthPriceInPayToken(subs);
        }

        if (payToken == receiveToken) {
            spentPayToken = subs.price;
            payToken.transferFrom(subs.subscriber, address(this), spentPayToken);

            if (gasLeftBeginning != 0) {
                uint256 gasUsed = gasLeftBeginning - gasleft();
                // 70000 for the gas cost of payToken.transfer
                gasCost = (gasUsed + 70000) * tx.gasprice * ethPriceInPayToken / 1e18;

                require(gasCost <= subs.price / 5, "Gas cost is too high (20% over the price)");
            }

            uint256 netAmount = spentPayToken * (1e18 - feeRate) / 1e18 - gasCost;

            payToken.transfer(subs.merchant, netAmount);
        } else {
            uint256 gasEstimate;

            (spentPayToken, , , gasEstimate) = uniswapQuoter.quoteExactOutputSingle(
                IQuoterV2.QuoteExactOutputSingleParams({
                    tokenIn: subs.payTokenAddress,
                    tokenOut: subs.receiveTokenAddress,
                    amount: subs.price,
                    fee: subs.feePool,
                    sqrtPriceLimitX96: 0
                })
            );

            if (maxPayAmount == 0) {
                maxPayAmount = subs.price * getReceiveTokenPrice(subs) / 1e18 * 1.005e18 / 1e18; // 0.5% slippage
            }

            require(spentPayToken <= maxPayAmount, "Swap inAmount is too high");

            payToken.transferFrom(subs.subscriber, address(this), spentPayToken);

            if (gasLeftBeginning != 0) {
                uint256 gasUsed = gasLeftBeginning - gasleft();
                gasCost = (gasUsed + gasEstimate) * tx.gasprice * ethPriceInPayToken / 1e18; // gas cost in payToken

                require(gasCost <= spentPayToken / 5, "Gas cost is too high (20% over the price)");
            }

            uint256 netAmountIn = spentPayToken * (1e18 - feeRate) / 1e18 - gasCost;

            payToken.approve(address(uniswapRouter), netAmountIn);

            uniswapRouter.exactInputSingle(
                ISwapRouter.ExactInputSingleParams({
                    tokenIn: subs.payTokenAddress,
                    tokenOut: subs.receiveTokenAddress,
                    fee: subs.feePool,
                    recipient: subs.merchant,
                    deadline: block.timestamp,
                    amountIn: netAmountIn,
                    amountOutMinimum: 0,
                    sqrtPriceLimitX96: 0
                })
            );
        }

        emit SubscriptionRenewed(subs.id, subs.merchant, subs.subscriber, spentPayToken, subs.expiredAt);
    }

    function withdrawERC20(address tokenAddress, uint256 amount) external onlyOwner {
        IERC20(tokenAddress).transfer(msg.sender, amount);
    }

    function setFeeRate(uint256 rate) external onlyOwner {
        require(rate < 0.1e18, "Fee rate must be less than 10%");
        feeRate = rate;
    }

    function setGasFeePool(uint24 feePool) external onlyOwner {
        gasFeePool = feePool;
    }

    function setAllowedPayTokens(address tokenAddress, bool allowed) external onlyOwner {
        allowedPayTokens[tokenAddress] = allowed;
    }

    function setAllowedReceiveTokens(address tokenAddress, bool allowed) external onlyOwner {
        allowedReceiveTokens[tokenAddress] = allowed;
    }

    function pause() external onlyOwner {
        _pause();
    }

    function unpause() external onlyOwner {
        _unpause();
    }

    // @return price of receiveToken in payToken (TWAP 15 minutes)
    function getReceiveTokenPrice(Subscription memory subs) internal view returns (uint256) {
        address poolAddress = IUniswapV3Factory(uniswapFactory).getPool(subs.receiveTokenAddress, subs.payTokenAddress, subs.feePool);
        return getTWAP18(poolAddress, 900, subs.receiveTokenAddress);
    }

    // @return price of WETH in payToken (TWAP 15 minutes)
    function getEthPriceInPayToken(Subscription memory subs) internal view returns (uint256) {
        if (subs.payTokenAddress == WETH) {
            return 1e18;
        } else {
            address poolAddress = IUniswapV3Factory(uniswapFactory).getPool(subs.payTokenAddress, WETH, gasFeePool);
            return getTWAP18(poolAddress, 900, WETH);
        }
    }

    // @return price in 1e18
    function getTWAP18(address poolAddress, uint32 duration, address token0) internal view returns (uint256) {
        IUniswapV3Pool pool = IUniswapV3Pool(poolAddress);

        uint32[] memory secondsAgos = new uint32[](2);
        secondsAgos[0] = duration;
        secondsAgos[1] = 0;

        (int56[] memory tickCumulatives, ) = pool.observe(secondsAgos);
        uint160 sqrtPriceX96 = getSqrtRatioAtTick(int24((tickCumulatives[1] - tickCumulatives[0]) / int56(uint56(duration))));

        if (pool.token0() == token0) {
            return Math.mulDiv(uint256(sqrtPriceX96) * uint256(sqrtPriceX96), 1e18, 2**192);
        } else {
            return Math.mulDiv(2**192, 1e18, uint256(sqrtPriceX96) * uint256(sqrtPriceX96));
        }
    }

    // https://github.com/Uniswap/v3-core/blob/d8b1c635c275d2a9450bd6a78f3fa2484fef73eb/contracts/libraries/TickMath.sol#L23
    function getSqrtRatioAtTick(int24 tick) internal pure returns (uint160 sqrtPriceX96) {
        int24 MIN_TICK = -887272;
        int24 MAX_TICK = -MIN_TICK;

        unchecked {
            uint256 absTick = tick < 0 ? uint256(-int256(tick)) : uint256(int256(tick));
            require(absTick <= uint256(uint24(MAX_TICK)), 'T');

            uint256 ratio = absTick & 0x1 != 0 ? 0xfffcb933bd6fad37aa2d162d1a594001 : 0x100000000000000000000000000000000;
            if (absTick & 0x2 != 0) ratio = (ratio * 0xfff97272373d413259a46990580e213a) >> 128;
            if (absTick & 0x4 != 0) ratio = (ratio * 0xfff2e50f5f656932ef12357cf3c7fdcc) >> 128;
            if (absTick & 0x8 != 0) ratio = (ratio * 0xffe5caca7e10e4e61c3624eaa0941cd0) >> 128;
            if (absTick & 0x10 != 0) ratio = (ratio * 0xffcb9843d60f6159c9db58835c926644) >> 128;
            if (absTick & 0x20 != 0) ratio = (ratio * 0xff973b41fa98c081472e6896dfb254c0) >> 128;
            if (absTick & 0x40 != 0) ratio = (ratio * 0xff2ea16466c96a3843ec78b326b52861) >> 128;
            if (absTick & 0x80 != 0) ratio = (ratio * 0xfe5dee046a99a2a811c461f1969c3053) >> 128;
            if (absTick & 0x100 != 0) ratio = (ratio * 0xfcbe86c7900a88aedcffc83b479aa3a4) >> 128;
            if (absTick & 0x200 != 0) ratio = (ratio * 0xf987a7253ac413176f2b074cf7815e54) >> 128;
            if (absTick & 0x400 != 0) ratio = (ratio * 0xf3392b0822b70005940c7a398e4b70f3) >> 128;
            if (absTick & 0x800 != 0) ratio = (ratio * 0xe7159475a2c29b7443b29c7fa6e889d9) >> 128;
            if (absTick & 0x1000 != 0) ratio = (ratio * 0xd097f3bdfd2022b8845ad8f792aa5825) >> 128;
            if (absTick & 0x2000 != 0) ratio = (ratio * 0xa9f746462d870fdf8a65dc1f90e061e5) >> 128;
            if (absTick & 0x4000 != 0) ratio = (ratio * 0x70d869a156d2a1b890bb3df62baf32f7) >> 128;
            if (absTick & 0x8000 != 0) ratio = (ratio * 0x31be135f97d08fd981231505542fcfa6) >> 128;
            if (absTick & 0x10000 != 0) ratio = (ratio * 0x9aa508b5b7a84e1c677de54f3e99bc9) >> 128;
            if (absTick & 0x20000 != 0) ratio = (ratio * 0x5d6af8dedb81196699c329225ee604) >> 128;
            if (absTick & 0x40000 != 0) ratio = (ratio * 0x2216e584f5fa1ea926041bedfe98) >> 128;
            if (absTick & 0x80000 != 0) ratio = (ratio * 0x48a170391f7dc42444e8fa2) >> 128;

            if (tick > 0) ratio = type(uint256).max / ratio;

            // this divides by 1<<32 rounding up to go from a Q128.128 to a Q128.96.
            // we then downcast because we know the result always fits within 160 bits due to our tick input constraint
            // we round up in the division so getTickAtSqrtRatio of the output price is always consistent
            sqrtPriceX96 = uint160((ratio >> 32) + (ratio % (1 << 32) == 0 ? 0 : 1));
        }
    }
}
