pragma solidity 0.8.34;

interface IUnisHookView {
    function poolEntropy(bytes32 poolId) external view returns (bytes32);
    function poolByObject(address obj) external view returns (bytes32);
}

interface IUnisRenderer {
    function objectURI(
        address  holder,
        uint256  slot,
        bytes32  paletteId,
        bytes32  entropy,
        string memory objName,
        string memory objSymbol
    ) external view returns (string memory);
}

/// @title UnisObject - one instance of the Objectized Asset standard
/// @notice ERC-20 surface with a slot-derived "object view". Each whole token
///         (1e18 units) a wallet holds maps to one onchain object — a glyph
///         generated by the shared UnisRenderer from (holder, slot, paletteId,
///         pool entropy). Transferring fractions moves only the fungible
///         portion; transferring whole units carries the object identity.
contract UnisObject {
    string  public name;
    string  public symbol;
    uint8   public constant decimals = 18;

    uint256 public totalSupply;
    bytes32 public paletteId;
    address public creator;
    address public factory;
    address public renderer;
    address public hook;

    bool   public tradingOpen;
    uint64 public openedAt;

    mapping(address => uint256) public balanceOf;
    mapping(address => mapping(address => uint256)) public allowance;
    mapping(address => bool) public bypass;

    event Transfer(address indexed from, address indexed to, uint256 value);
    event Approval(address indexed holder, address indexed spender, uint256 value);
    event TradingOpened(uint64 at);
    event BypassSet(address indexed account, bool flag);

    error InsufficientBalance();
    error InsufficientAllowance();
    error ZeroAddress();
    error NotFactory();
    error NotCreator();
    error TradingClosed();

    modifier onlyFactory() { if (msg.sender != factory) revert NotFactory(); _; }
    modifier onlyCreator() { if (msg.sender != creator) revert NotCreator(); _; }

    constructor(
        string memory _name,
        string memory _symbol,
        uint256       _supply,
        bytes32       _paletteId,
        address       _creator,
        address       _factory,
        address       _renderer,
        address       _hook
    ) {
        if (_creator == address(0)) revert ZeroAddress();
        name      = _name;
        symbol    = _symbol;
        paletteId = _paletteId;
        creator   = _creator;
        factory   = _factory;
        renderer  = _renderer;
        hook      = _hook;

        totalSupply       = _supply;
        balanceOf[_creator] = _supply;

        bypass[_creator] = true;
        bypass[_factory] = true;
        if (_hook != address(0)) bypass[_hook] = true;

        emit Transfer(address(0), _creator, _supply);
    }

    function approve(address spender, uint256 value) external returns (bool) {
        allowance[msg.sender][spender] = value;
        emit Approval(msg.sender, spender, value);
        return true;
    }

    function transfer(address to, uint256 value) external returns (bool) {
        _move(msg.sender, to, value);
        return true;
    }

    function transferFrom(address from, address to, uint256 value) external returns (bool) {
        uint256 a = allowance[from][msg.sender];
        if (a != type(uint256).max) {
            if (a < value) revert InsufficientAllowance();
            unchecked { allowance[from][msg.sender] = a - value; }
        }
        _move(from, to, value);
        return true;
    }

    function _move(address from, address to, uint256 value) internal {
        if (to == address(0)) revert ZeroAddress();
        if (balanceOf[from] < value) revert InsufficientBalance();
        if (!tradingOpen && !bypass[from] && !bypass[to]) revert TradingClosed();
        unchecked {
            balanceOf[from] -= value;
            balanceOf[to]   += value;
        }
        emit Transfer(from, to, value);
    }

    /// @notice Whole-unit count for this holder; each whole unit = one object.
    function wholeObjects(address holder) external view returns (uint256) {
        return balanceOf[holder] / 1e18;
    }

    /// @notice Returns the data URI for the object at (holder, slot).
    function objectURI(address holder, uint256 slot) external view returns (string memory) {
        if (renderer == address(0)) return "";
        bytes32 entropy;
        if (hook != address(0)) {
            try IUnisHookView(hook).poolByObject(address(this)) returns (bytes32 pid) {
                if (pid != bytes32(0)) {
                    try IUnisHookView(hook).poolEntropy(pid) returns (bytes32 e) {
                        entropy = e;
                    } catch {}
                }
            } catch {}
        }
        return IUnisRenderer(renderer).objectURI(holder, slot, paletteId, entropy, name, symbol);
    }

    // ---- factory / creator controls ----

    function openTrading() external onlyFactory {
        if (tradingOpen) return;
        tradingOpen = true;
        openedAt    = uint64(block.timestamp);
        emit TradingOpened(openedAt);
    }

    function setBypass(address account, bool flag) external onlyFactory {
        if (account == address(0)) revert ZeroAddress();
        bypass[account] = flag;
        emit BypassSet(account, flag);
    }

    function setRenderer(address r) external onlyCreator { renderer = r; }
}
